   "versionNonce": 242369546,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why a Git clone, not a ConfigMap:\nthe repo is far over the 1 MB cap.\n\nWhy a webroot whitelist:\n.git, README and Dockerfile can\nnever be served.\n\nWhy not part of apex-static:\na failed clone must never block the\nWebFinger page that Tailscale OIDC\ndiscovery depends on.",
   "originalText": "Why a Git clone, not a ConfigMap:\nthe repo is far over the 1 MB cap.\n\nWhy a webroot whitelist:\n.git, README and Dockerfile can\nnever be served.\n\nWhy not part of apex-static:\na failed clone must never block the\nWebFinger page that Tailscale OIDC\ndiscovery depends on.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": false,
   "lineHeight": 1.25
  },
