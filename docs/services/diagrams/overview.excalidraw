   "versionNonce": 1863310598,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why a proxy, not the metric UI: that host sits\nbehind Authentik ForwardAuth, and a page cannot\nfinish a login redirect inside a background fetch.\n\nWithout the Proxmox token the page still works:\nthe Proxmox slide just does not appear.\n\nReachability badges on the app icons are the\nbrowser's own no-cors fetch: \"can I open this\nfrom here\".",
   "originalText": "Why a proxy, not the metric UI: that host sits\nbehind Authentik ForwardAuth, and a page cannot\nfinish a login redirect inside a background fetch.\n\nWithout the Proxmox token the page still works:\nthe Proxmox slide just does not appear.\n\nReachability badges on the app icons are the\nbrowser's own no-cors fetch: \"can I open this\nfrom here\".",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": false,
   "lineHeight": 1.25
  },
  {
   "id": "ove38",
   "type": "text",
   "x": 540,
   "y": 710,
   "width": 598.0,
   "height": 16.2,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1887730187,
   "version": 1,
   "versionNonce": 785413442,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Accepted cost: anyone on the LAN can run PromQL against cluster telemetry through this page.",
   "originalText": "Accepted cost: anyone on the LAN can run PromQL against cluster telemetry through this page.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
