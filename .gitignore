# ============================================================================
# macOS
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride

# ============================================================================
# Terraform
# ============================================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!**/*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# ============================================================================
# Ansible
# ============================================================================
*.retry
ansible/.ansible/
ansible/inventory/group_vars/**/vault.yml
!ansible/inventory/group_vars/**/*.example.yml
# macOS control-node warm NetBox inventory cache (materialized by
# .config/scripts/refresh-netbox-inventory-cache.sh — see frigg-control-node.md)
ansible/inventory/.netbox-cache.yml
ansible/collections/*
# generated per run by scripts/burst/burst-up (10b2) — droplet IPs, not secrets, but ephemeral
ansible/inventory-burst/hosts.generated.json

# ============================================================================
# Kubernetes / Flux
# ============================================================================
kubeconfig
*.kubeconfig

# ============================================================================
# Secrets (belt-and-suspenders — catches accidental commits)
# ============================================================================
*.key
*.pem
*.p12
*.pfx
.aws/credentials
# *password* and *credential* deliberately omitted — would catch too many
# legitimate files (docs, configs, role variables that *reference* secrets
# but don't contain them). The named patterns above + the per-tool patterns
# above (vault.yml, *.tfvars) are the real defense.

# ============================================================================
# Python (factorio reconcile script, future automation)
# ============================================================================
__pycache__/
*.pyc
*.pyo

# ============================================================================
# Editors
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# ============================================================================
# Environment / shell
# ============================================================================
.env
.env.*
!.env.example
.envrc
.direnv/

# ============================================================================
# Build artifacts (rare in this repo but possible)
# ============================================================================
*.log
*.tar.gz
*.zip

# ============================================================================
# Claude working tree (worktrees, local settings) — but agents/ and scripts/ are
# versioned: the chart-bump agent + its helper scripts, and the project settings
# + SessionStart hook (.claude/hooks/) are part of the repo.
# ============================================================================
.claude/*
!.claude/agents/
!.claude/scripts/
!.claude/hooks/
!.claude/settings.json
