{
  "title": "02 — Resource usage (CPU / memory)",
  "rows": [
    {
      "panels": [
        {
          "title": "Cluster CPU usage (cores, by node)",
          "width": 6,
          "expr": ["sum by(node) (rate(container_cpu_usage_seconds_total{image!=\"\"}[5m]))"]
        },
        {
          "title": "Cluster memory usage (bytes, by node)",
          "width": 6,
          "expr": ["sum by(node) (container_memory_working_set_bytes{image!=\"\"})"]
        }
      ]
    },
    {
      "panels": [
        {
          "title": "CPU usage by namespace (cores)",
          "width": 6,
          "expr": ["sum by(namespace) (rate(container_cpu_usage_seconds_total{image!=\"\",namespace!=\"\"}[5m]))"]
        },
        {
          "title": "Memory usage by namespace (bytes)",
          "width": 6,
          "expr": ["sum by(namespace) (container_memory_working_set_bytes{image!=\"\",namespace!=\"\"})"]
        }
      ]
    },
    {
      "panels": [
        {
          "title": "Top 10 pods — CPU (5m rate, cores)",
          "width": 6,
          "expr": ["topk(10, sum by(namespace,pod) (rate(container_cpu_usage_seconds_total{image!=\"\"}[5m])))"]
        },
        {
          "title": "Top 10 pods — RSS (bytes)",
          "width": 6,
          "expr": ["topk(10, sum by(namespace,pod) (container_memory_working_set_bytes{image!=\"\"}))"]
        }
      ]
    },
    {
      "panels": [
        {
          "title": "Container restarts last 1h (by namespace+pod)",
          "width": 6,
          "expr": ["topk(15, sum by(namespace,pod) (increase(kube_pod_container_status_restarts_total[1h])))"]
        },
        {
          "title": "Pods stuck in Pending > 1m (by namespace)",
          "width": 6,
          "expr": ["sum by(namespace) (kube_pod_status_phase{phase=\"Pending\"})"]
        }
      ]
    }
  ]
}
