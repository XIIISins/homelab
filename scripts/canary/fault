#!/usr/bin/env bash
# scripts/canary/fault — inject or clear a fault on one canary (Phase 10f soak).
#
#   fault stop    <canary-1|canary-2|canary-3> <vlagent.service|zabbix-agent2.service>
#   fault restore <canary-1|canary-2|canary-3> <vlagent.service|zabbix-agent2.service>
#   fault status  <canary-1|canary-2|canary-3> <vlagent.service|zabbix-agent2.service>
#   fault flag    <canary-1|canary-2|canary-3> <high|disaster>    # synthetic High/Disaster problem, no service touched
#   fault unflag  <canary-1|canary-2|canary-3> <high|disaster>
#
# `stop` is the fault the autonomy policy `restart-failed-unit` is meant to heal: the "Canary smoke test" Zabbix template
# (ansible/playbooks/files/zabbix/canary-smoke-test.yml) raises a High problem, Gna diagnoses it (runbook
# RB-UNIT-STOPPED-T1) and, with `/aiops autonomy on`, the Toolbelt reads the unit itself and restarts it. `restore` is
# the manual undo; `status` shows ActiveState.
#
# `flag` creates /var/lib/aiops-smoke/<high|disaster> on the canary, which the same template turns into a High or a
# Disaster problem without stopping anything: it exercises Zabbix -> Gna -> Toolbelt -> Discord for both severities.
# `unflag` removes it (the problem recovers by itself within a minute).
#
# Canary only, two units and two flags only: the same allow-list as the registry's restart-unit. Nothing else can be
# touched with this script, and it never reaches a real host (docs/procedures/canary-pool.md "Guardrails").
# Runs ad-hoc ansible from this checkout with the warm IaC env.
set -euo pipefail

usage() { sed -n '2,19p' "$0"; exit "${1:-2}"; }
[ "$#" -eq 3 ] || usage
verb="$1" host="$2" what="$3"

case "$verb" in stop|restore|status|flag|unflag) ;; -h|--help) usage 0 ;; *) usage ;; esac
case "$host" in canary-1|canary-2|canary-3) ;; *) echo "fault: '$host' is not a canary" >&2; exit 2 ;; esac
case "$verb" in
  flag|unflag) case "$what" in high|disaster) ;; *) echo "fault: '$what' is not high|disaster" >&2; exit 2 ;; esac ;;
  *) case "$what" in vlagent.service|zabbix-agent2.service) ;; *) echo "fault: '$what' is not an allow-listed canary unit" >&2; exit 2 ;; esac ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
[ -r "$HOME/.cache/homelab/env.sh" ] && . "$HOME/.cache/homelab/env.sh"   # a plain exports file: source it, never cat it
cd "$root/ansible"

run() { ansible -i inventory/hosts.yml "$host" -b "$@"; }

case "$verb" in
  stop)    run -m ansible.builtin.systemd -a "name=$what state=stopped" ;;
  restore) run -m ansible.builtin.systemd -a "name=$what state=started" ;;
  status)  run -m ansible.builtin.command -a "systemctl is-active $what" ;;
  flag)    run -m ansible.builtin.file -a "path=/var/lib/aiops-smoke state=directory mode=0755"
           run -m ansible.builtin.file -a "path=/var/lib/aiops-smoke/$what state=touch mode=0644" ;;
  unflag)  run -m ansible.builtin.file -a "path=/var/lib/aiops-smoke/$what state=absent" ;;
esac
echo "fault: $verb $what on $host done at $(date -u +%FT%TZ)"
