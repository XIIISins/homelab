#!/usr/bin/env python3
"""mint-restore-key: create, verify and rotate the read-only backup-restore AWS key. No AWS console.

The IAM user `homelab-backup-restore` is declared in terraform/aws/backups.tf (read-only on the etcd/,
vault-raft/ and calico/ prefixes of the backup bucket; no write, no delete, no KMS). Terraform creates NO key
for it, so no secret lands in state or Vault. This tool mints the key with the AWS CLI and puts it straight
into 1Password, the one store that survives the homelab being gone:

    mint-restore-key check     are the admin credentials and the IAM user in place? (read-only)
    mint-restore-key mint      create the key, store it in 1Password, read it back, verify it
    mint-restore-key verify    prove the stored key reads all three prefixes and CANNOT write/delete/IAM
    mint-restore-key rotate    mint a second key, store + verify it, then delete the old one

The admin identity that may call iam:CreateAccessKey is the Terraform bootstrap key, read from its 1Password item
(`--admin-item`, default the "[Asgard] - Terraform - AWS - Bootstrap access key" UUID). Keys and secrets are only
ever passed to the aws/op child processes (env / argv), never printed, and scrubbed from any error text.
The 1Password item written is "[Bootstrap] - Manual - AWS - Backup restore access key" (API Credential,
username = access key id, credential = secret, the repo's AWS convention).
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile
import time

OP_VAULT = "Homelab 2.0"
ADMIN_ITEM = "lhf4xzp3uqehkkease5gidthci"  # [Asgard] - Terraform - AWS - Bootstrap access key
ITEM_TITLE = "[Bootstrap] - Manual - AWS - Backup restore access key"
IAM_USER = "homelab-backup-restore"
BUCKET = "xiiisins-homelab-backups"
REGION = "eu-west-1"
PREFIXES = ("etcd/", "vault-raft/", "calico/")
NOTE = ("Read-only restore identity for s3://xiiisins-homelab-backups (etcd/, vault-raft/, calico/). Minted by "
        "scripts/secrets/mint-restore-key; NOT stored in Vault (it must work when Vault is gone). For restore drills "
        "and real disaster recovery. The Vault leg also needs the decrypt-only 'KMS unseal access key' item.")
_secret = set()


class Fatal(Exception):
    pass


def scrub(t):
    for s in _secret:
        if len(s) >= 6:
            t = t.replace(s, "<redacted>")
    return t


def one_line(t):
    ls = [l for l in scrub(t).strip().splitlines() if l.strip()]
    return ls[0][:300] if ls else "(no output)"


def run(argv, env=None):
    p = subprocess.run(argv, capture_output=True, text=True, timeout=180, env=env)
    return p.returncode, p.stdout, p.stderr


def aws_env(key_id, secret):
    env = {k: v for k, v in os.environ.items() if not k.startswith("AWS_")}
    env.update({"AWS_ACCESS_KEY_ID": key_id, "AWS_SECRET_ACCESS_KEY": secret, "AWS_DEFAULT_REGION": REGION,
                "AWS_PAGER": "", "AWS_SHARED_CREDENTIALS_FILE": "/dev/null", "AWS_CONFIG_FILE": "/dev/null"})
    return env


def aws(env, *args):
    return run(["aws", *args], env=env)


def op_item(ref):
    rc, out, err = run(["op", "item", "get", ref, f"--vault={OP_VAULT}", "--format=json", "--reveal"])
    if rc != 0:
        if "isn't an item" in err or "not found" in err.lower():
            return None
        raise Fatal(f"op: {one_line(err)}")
    item = json.loads(out)
    f = {x.get("label") or x.get("id"): str(x.get("value")) for x in item.get("fields", []) if x.get("value")}
    _secret.update(f.get(k, "") for k in ("credential", "password"))
    return {"id": item["id"], "username": f.get("username", ""), "credential": f.get("credential", "")}


def admin_env():
    it = op_item(ADMIN_ITEM)
    if not it or not it["username"] or not it["credential"]:
        raise Fatal("could not read the AWS bootstrap admin key from 1Password (--admin-item)")
    return aws_env(it["username"], it["credential"])


def restore_env():
    it = op_item(ITEM_TITLE)
    if not it or not it["username"] or not it["credential"]:
        raise Fatal(f"1Password item '{ITEM_TITLE}' not found: run `mint-restore-key mint` first")
    return aws_env(it["username"], it["credential"]), it


def user_keys(env):
    rc, out, err = aws(env, "iam", "list-access-keys", "--user-name", IAM_USER, "--output", "json")
    if rc != 0:
        if "NoSuchEntity" in err:
            raise Fatal(f"IAM user {IAM_USER} does not exist: run `terraform apply` in terraform/aws first (from the main checkout)")
        raise Fatal(f"aws iam list-access-keys: {one_line(err)}")
    return json.loads(out)["AccessKeyMetadata"]


def create_key(env):
    rc, out, err = aws(env, "iam", "create-access-key", "--user-name", IAM_USER, "--output", "json")
    if rc != 0:
        raise Fatal(f"aws iam create-access-key: {one_line(err)}")
    k = json.loads(out)["AccessKey"]
    _secret.add(k["SecretAccessKey"])
    return k["AccessKeyId"], k["SecretAccessKey"]


def delete_key(env, key_id):
    return aws(env, "iam", "delete-access-key", "--user-name", IAM_USER, "--access-key-id", key_id)[0] == 0


def store_in_1p(key_id, secret, existing):
    assigns = [f"username[text]={key_id}", f"credential[concealed]={secret}"]
    if existing:
        rc, _, err = run(["op", "item", "edit", existing["id"], f"--vault={OP_VAULT}", *assigns])
    else:
        rc, _, err = run(["op", "item", "create", "--category", "API Credential", "--title", ITEM_TITLE,
                          f"--vault={OP_VAULT}", f"notesPlain={NOTE}", *assigns])
    if rc != 0:
        raise Fatal(f"op: {one_line(err)}")
    back = op_item(ITEM_TITLE)
    if not back or back["username"] != key_id or back["credential"] != secret:
        raise Fatal("1Password read-back does not match the minted key")


def verify(env, wait=True):
    """Positive: caller identity, list + 1-byte read per prefix. Negative: write, delete, IAM must be denied."""
    results = []

    def check(name, ok, detail=""):
        results.append(ok)
        print(f"  {'PASS' if ok else 'FAIL'}  {name}" + (f"  ({detail})" if detail else ""))

    deadline = time.time() + (90 if wait else 0)
    while True:  # a new IAM key can take a few seconds to be accepted
        rc, out, err = aws(env, "sts", "get-caller-identity", "--output", "json")
        if rc == 0 or time.time() >= deadline:
            break
        time.sleep(5)
    arn = json.loads(out).get("Arn", "") if rc == 0 else ""
    check("identity is the restore user", IAM_USER in arn, arn.split("/")[-1] if arn else one_line(err))
    for pre in PREFIXES:
        rc, out, err = aws(env, "s3api", "list-objects-v2", "--bucket", BUCKET, "--prefix", pre, "--max-keys", "1", "--output", "json")
        if rc != 0:
            check(f"list {pre}", False, one_line(err))
            continue
        contents = json.loads(out).get("Contents") or []
        if not contents:
            check(f"list {pre}", True, "prefix is empty, nothing to read")
            continue
        key = contents[0]["Key"]
        rc, _, err = aws(env, "s3api", "get-object", "--bucket", BUCKET, "--key", key, "--range", "bytes=0-0", "/dev/null")
        check(f"list + read {pre}", rc == 0, "ok" if rc == 0 else one_line(err))
    denied = lambda rc, err: rc != 0 and ("AccessDenied" in err or "not authorized" in err or "explicit deny" in err)
    with tempfile.NamedTemporaryFile() as body:  # the aws CLI wants a real file for --body, not /dev/null
        body.write(b"restore-verify: this upload must be denied\n")
        body.flush()
        rc, _, err = aws(env, "s3api", "put-object", "--bucket", BUCKET, "--key", "restore-verify/should-fail", "--body", body.name)
    check("write is denied", denied(rc, err), "AccessDenied" if denied(rc, err) else one_line(err))
    rc, _, err = aws(env, "s3api", "delete-object", "--bucket", BUCKET, "--key", "etcd/should-fail")
    check("delete is denied", denied(rc, err), "AccessDenied" if denied(rc, err) else one_line(err))
    rc, _, err = aws(env, "iam", "list-users")
    check("IAM is denied", denied(rc, err), "AccessDenied" if denied(rc, err) else one_line(err))
    return all(results)


def main():
    global ADMIN_ITEM
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=("check", "mint", "verify", "rotate"))
    ap.add_argument("--admin-item", default=ADMIN_ITEM)
    args = ap.parse_args()
    ADMIN_ITEM = args.admin_item
    try:
        for b in ("aws", "op"):
            if run(["which", b])[0] != 0:
                raise Fatal(f"`{b}` not found on PATH")
        if args.cmd == "verify":
            env, _ = restore_env()
            print(f"verifying the stored restore key against s3://{BUCKET}")
            return 0 if verify(env, wait=False) else 1

        admin = admin_env()
        rc, out, err = aws(admin, "sts", "get-caller-identity", "--output", "json")
        if rc != 0:
            raise Fatal(f"the bootstrap admin key does not work: {one_line(err)}")
        keys = user_keys(admin)
        item = op_item(ITEM_TITLE)
        print(f"admin identity ok; IAM user {IAM_USER} has {len(keys)} access key(s); 1Password item: {'present' if item else 'absent'}")
        if args.cmd == "check":
            return 0

        if args.cmd == "mint":
            if item:
                known = [k["AccessKeyId"] for k in keys]
                if item["username"] in known:
                    print("a key is already minted and stored; run `verify` (or `rotate` to replace it)")
                    return 0
                raise Fatal("the 1Password item holds a key AWS no longer has; run `rotate` or delete the item")
            if keys:
                raise Fatal(f"{len(keys)} key(s) exist for the user but none is in 1Password (orphaned): delete them with "
                            f"`aws iam delete-access-key` or investigate who created them, then re-run")
            key_id, secret = create_key(admin)
            try:
                store_in_1p(key_id, secret, None)
            except Fatal:
                delete_key(admin, key_id)  # never leave a key that exists only in this process
                raise
            print(f"minted key {key_id[:8]}... and stored it in 1Password ('{ITEM_TITLE}')")
        else:  # rotate
            if not item:
                raise Fatal("nothing to rotate: no 1Password item yet, run `mint`")
            if len(keys) >= 2:
                raise Fatal("the user already has two keys (the AWS limit): delete the stale one first")
            old_id = item["username"]
            key_id, secret = create_key(admin)
            try:
                store_in_1p(key_id, secret, item)
            except Fatal:
                delete_key(admin, key_id)
                raise
            print(f"minted a new key {key_id[:8]}... and replaced it in 1Password")
            ok = verify(aws_env(key_id, secret))
            if not ok:
                raise Fatal(f"the new key failed verification: NOT deleting the old key {old_id[:8]}...")
            print(f"{'deleted' if delete_key(admin, old_id) else 'COULD NOT delete'} the old key {old_id[:8]}...")
            return 0
        return 0 if verify(aws_env(key_id, secret)) else 1
    except Fatal as e:
        print(f"error: {scrub(str(e))}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
