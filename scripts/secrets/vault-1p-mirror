#!/usr/bin/env python3
"""vault-1p-mirror: copy secrets between HashiCorp Vault and 1Password without hand-typing a value.

Mirrors are declared in scripts/secrets/mirror-map.toml (names only, no values).

    vault-1p-mirror status   [NAME ...]                      compare both sides
    vault-1p-mirror to-1p    [NAME ...] [--apply] [--overwrite]   Vault  -> 1Password
    vault-1p-mirror to-vault [NAME ...] [--apply] [--overwrite]   1Password -> Vault

    vault-1p-mirror unmapped                                 Vault paths / 1P "Mirror" items the map does not know
    vault-1p-mirror pin                                      write each existing item's op_id into the map

    vault-1p-mirror mirror-to <1p|vault> <src> [<dst>] [--apply] [--overwrite] [--title T]
        one field, no map entry needed. Refs: 1Password `<item-uuid>/<field label>`, Vault
        `<path>/<field>` (the last segment is the field). <dst> may be omitted when the pair is
        in the map. `--title` lets `mirror-to 1p` create a missing 1P item.
        e.g. mirror-to vault 4srpq...jti/credential ansible/aiops/zabbix-token/value --apply

Safety, by design (these are the mistakes a hand-run `vault kv patch` makes):
  * Dry run by default. Nothing is written without --apply.
  * A destination value that already exists and DIFFERS is never replaced without --overwrite.
  * Every write is read back and compared by SHA-256. A mismatch exits non-zero.
  * Values are never printed. Output shows only length and a short hash prefix, and any error text
    from vault/op is scrubbed of the values this run handled.
  * Values go through argv of a single `vault`/`op` call (no shell, no stdin trickery, no
    command-substitution word-splitting). A value that vault would treat specially (`@file`, `-`)
    is refused instead of silently mangled.
  * Odd values (leading/trailing space, CR, a lone trailing newline on a one-line secret) are
    refused unless --allow-odd.

Needs: `vault` logged in with a token that can read (and for to-vault, write) the paths, and `op`
signed in. Both come from the usual shim: `source .config/scripts/homelab.sh && vault-homelab-env`.
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

MAP_FILE = Path(__file__).with_name("mirror-map.toml")
LABEL_RE = re.compile(r"^[A-Za-z0-9_ -]+$")
VFIELD_RE = re.compile(r"^[A-Za-z0-9_.-]+$")
_seen = set()  # every value handled this run, for scrubbing error text


class Fatal(Exception):
    pass


def sig(v):
    return f"len={len(v):<4} sha={hashlib.sha256(v.encode()).hexdigest()[:8]}"


def scrub(text):
    for s in _seen:
        if len(s) >= 4:
            text = text.replace(s, "<redacted>")
    return text


def first_line(text):
    lines = [ln for ln in scrub(text).strip().splitlines() if ln.strip()]
    return lines[0][:300] if lines else "(no output)"


def run(argv):
    p = subprocess.run(argv, capture_output=True, text=True, timeout=90)
    return p.returncode, p.stdout, p.stderr


def odd(v):
    if v == "":
        return "empty"
    if "\r" in v:
        return "contains a carriage return"
    if v != v.strip(" \t"):
        return "leading/trailing space"
    if v.endswith("\n") and "\n" not in v[:-1]:
        return "single-line value with a trailing newline"
    return None


# ---------------------------------------------------------------- Vault

def vault_read(mount, path):
    rc, out, err = run(["vault", "kv", "get", "-format=json", f"-mount={mount}", path])
    if rc != 0:
        if "No value found" in err:
            return None
        raise Fatal(f"vault read {path}: {first_line(err)}")
    data = json.loads(out)["data"]["data"]
    vals = {k: str(v) for k, v in data.items()}
    _seen.update(vals.values())
    return vals


def vault_write(mount, path, fields, exists):
    for k, v in fields.items():
        if not VFIELD_RE.match(k):
            raise Fatal(f"vault field name {k!r} has odd characters")
        if v.startswith("@") or v == "-":
            raise Fatal(f"{path}:{k} starts with '@' or is '-': the vault CLI would read a file/stdin "
                        "instead of storing it. Not written.")
    verb = "patch" if exists else "put"
    rc, _, err = run(["vault", "kv", verb, f"-mount={mount}", path] + [f"{k}={v}" for k, v in fields.items()])
    if rc != 0:
        raise Fatal(f"vault {verb} {path}: {first_line(err)}")


# ---------------------------------------------------------------- 1Password

def op_read(opvault, ref):
    rc, out, err = run(["op", "item", "get", ref, f"--vault={opvault}", "--format=json", "--reveal"])
    if rc != 0:
        if "isn't an item" in err or "not found" in err.lower():
            return None
        raise Fatal(f"op read {ref!r}: {first_line(err)}")
    item = json.loads(out)
    fields = {}
    for f in item.get("fields", []):
        if f.get("value") not in (None, ""):
            for key in (f.get("label"), f.get("id")):
                if key:
                    fields.setdefault(key, str(f["value"]))
    _seen.update(fields.values())
    return {"id": item["id"], "fields": fields}


def op_assign(label, ftype, value):
    if not LABEL_RE.match(label):
        raise Fatal(f"1P label {label!r}: only letters, digits, space, _ and - are supported")
    return f"{label}[{ftype}]={value}"


def op_write(opvault, existing, title, entry_fields, category="API Credential"):
    """entry_fields: list of (label, ftype, value). existing: {'id':..} or None (create)."""
    assigns = [op_assign(l, t, v) for l, t, v in entry_fields]
    if existing:
        rc, _, err = run(["op", "item", "edit", existing["id"], f"--vault={opvault}"] + assigns)
        if rc != 0:
            raise Fatal(f"op edit {title!r}: {first_line(err)}")
        return existing["id"]
    rc, out, err = run(["op", "item", "create", "--category", category, "--title", title,
                        f"--vault={opvault}", "--format=json"] + assigns)
    if rc != 0:
        raise Fatal(f"op create {title!r}: {first_line(err)}")
    return json.loads(out)["id"]


# ---------------------------------------------------------------- the mirror

def parse_spec(spec):
    label, _, kind = spec.partition(":")
    return label, ("text" if kind == "text" else "concealed")


IGNORES = []  # [(vault_path or prefix/, reason)] from the map's [[ignore]] blocks


def load_map():
    cfg = tomllib.loads(MAP_FILE.read_text())
    IGNORES[:] = [(i["vault_path"], i.get("reason", "")) for i in cfg.get("ignore", [])]
    d = cfg.get("defaults", {})
    return d.get("op_vault", "Homelab 2.0"), d.get("vault_mount", "secret"), cfg.get("mirror", [])


def select(entries, names):
    by = {e["name"]: e for e in entries}
    if not names:
        return entries
    bad = [n for n in names if n not in by]
    if bad:
        raise Fatal(f"unknown name(s): {', '.join(bad)}. Known: {', '.join(by)}")
    return [by[n] for n in names]


def snapshot(entry, opvault, mount):
    vdata = vault_read(mount, entry["vault_path"])
    item = op_read(opvault, entry.get("op_id") or entry["op_title"])
    rows = []
    for vf, spec in entry["fields"].items():
        label, ftype = parse_spec(spec)
        rows.append({"vf": vf, "label": label, "ftype": ftype,
                     "vault": (vdata or {}).get(vf), "op": (item or {"fields": {}})["fields"].get(label)})
    return vdata, item, rows


def state(r):
    v, o = r["vault"], r["op"]
    if v is None and o is None:
        return "BOTH-MISSING"
    if v is None:
        return "VAULT-MISSING"
    if o is None:
        return "1P-MISSING"
    return "SYNC" if v == o else "DIFFERS"


def cmd_status(args, opvault, mount, entries):
    bad = 0
    for e in select(entries, args.names):
        _, item, rows = snapshot(e, opvault, mount)
        print(f"{e['name']}  (vault {e['vault_path']}  <->  1P {'found' if item else 'NO ITEM'}: {e['op_title']})")
        for r in rows:
            st = state(r)
            bad += st != "SYNC"
            vs = sig(r["vault"]) if r["vault"] is not None else "-"
            os_ = sig(r["op"]) if r["op"] is not None else "-"
            print(f"  {r['vf']:<10} {st:<14} vault[{vs}]  1p[{os_}]")
    print("\nall in sync" if not bad else f"\n{bad} field(s) not in sync")
    return 0 if not bad else 2


def cmd_copy(args, opvault, mount, entries, direction):
    to_op = direction == "to-1p"
    if args.apply and not args.names and not args.all:
        raise Fatal("--apply needs explicit NAME(s) or --all")
    failures = 0
    writes = 0
    for e in select(entries, args.names):
        vdata, item, rows = snapshot(e, opvault, mount)
        todo = []
        print(f"{e['name']}")
        for r in rows:
            src, dst = (r["vault"], r["op"]) if to_op else (r["op"], r["vault"])
            where = "vault" if to_op else "1P"
            if src is None:
                print(f"  {r['vf']:<10} ERROR  source ({where}) has no value; skipped")
                failures += 1
                continue
            why = odd(src)
            if why and not args.allow_odd:
                print(f"  {r['vf']:<10} REFUSED source value is odd ({why}); fix the source or pass --allow-odd")
                failures += 1
                continue
            if dst is None:
                act = "CREATE"
            elif dst == src:
                print(f"  {r['vf']:<10} SYNC    already identical ({sig(src)})")
                continue
            elif args.overwrite:
                act = "OVERWRITE"
            else:
                print(f"  {r['vf']:<10} DIFFERS destination has a different value; skipped (use --overwrite "
                      f"to replace it)  src[{sig(src)}] dst[{sig(dst)}]")
                failures += 1
                continue
            print(f"  {r['vf']:<10} {act:<9} {sig(src)}" + ("" if args.apply else "   (dry run)"))
            todo.append((r, src))
        if not (args.apply and todo):
            continue
        try:
            if to_op:
                fields = [(r["label"], r["ftype"], src) for r, src in todo]
                new_id = op_write(opvault, item, e["op_title"], fields)
                if item is None:
                    pinned = pin_map(e["name"], new_id)
                    print(f"  created 1P item id={new_id}" + ("  (op_id pinned in mirror-map.toml)" if pinned else ""))
                after = op_read(opvault, new_id)
                got = lambda r: (after or {"fields": {}})["fields"].get(r["label"])
            else:
                vault_write(mount, e["vault_path"], {r["vf"]: src for r, src in todo}, vdata is not None)
                after = vault_read(mount, e["vault_path"]) or {}
                got = lambda r: after.get(r["vf"])
            writes += len(todo)
            for r, src in todo:
                ok = got(r) == src
                print(f"  {r['vf']:<10} verify  {'OK' if ok else 'MISMATCH'}  written[{sig(src)}] read-back[{sig(got(r) or '')}]")
                failures += not ok
        except Fatal as ex:
            print(f"  ERROR  {ex}")
            failures += 1
    mode = "applied" if args.apply else "dry run, nothing written (add --apply)"
    print(f"\n{mode}; {writes} field(s) written; {failures} problem(s)")
    return 1 if failures else 0


def pin_map(name, item_id):
    """Insert `op_id = "..."` after the entry's op_title line in the map (text edit, keeps comments)."""
    if name == "adhoc":
        return False
    lines = MAP_FILE.read_text().splitlines(keepends=True)
    for i, ln in enumerate(lines):
        if ln.strip() == f'name = "{name}"':
            j = i
            while j < len(lines) and lines[j].strip() and not lines[j].startswith("[["):
                if lines[j].startswith("op_id"):
                    return False
                j += 1
            for k in range(i, j):
                if lines[k].startswith("op_title"):
                    lines.insert(k + 1, f'op_id = "{item_id}"\n')
                    MAP_FILE.write_text("".join(lines))
                    return True
    return False


def vault_walk(mount, prefix=""):
    rc, out, err = run(["vault", "kv", "list", "-format=json", f"-mount={mount}"] + ([prefix] if prefix else []))
    if rc != 0:
        if not prefix:
            raise Fatal(f"vault list: {first_line(err)}")
        return
    for k in json.loads(out):
        if k.endswith("/"):
            yield from vault_walk(mount, prefix + k)
        else:
            yield prefix + k


def is_ignored(path):
    return any(path == pre or (pre.endswith("/") and path.startswith(pre)) for pre, _ in IGNORES)


def cmd_unmapped(args, opvault, mount, entries):
    mapped = {e["vault_path"] for e in entries}
    loose = [p for p in vault_walk(mount) if p not in mapped and not is_ignored(p)]
    rc, out, err = run(["op", "item", "list", f"--vault={opvault}", "--format=json"])
    if rc != 0:
        raise Fatal(f"op list: {first_line(err)}")
    ids = {e.get("op_id") for e in entries}
    titles = {e["op_title"] for e in entries}
    stray = [(i["id"], i["title"]) for i in json.loads(out)
             if "Mirror" in i["title"] and i["id"] not in ids and i["title"] not in titles]
    print(f"Vault paths in neither [[mirror]] nor [[ignore]]: {len(loose)}")
    for pth in loose:
        print(f"  {pth}")
    print(f"1Password 'Mirror' items no map entry points at: {len(stray)}")
    for iid, t in stray:
        print(f"  {iid}  {t}")
    if loose or stray:
        print("\nAdd a [[mirror]] (or [[ignore]]) block to scripts/secrets/mirror-map.toml for each.")
    return 2 if (loose or stray) else 0


def cmd_pin(args, opvault, mount, entries):
    n = 0
    for e in entries:
        if e.get("op_id"):
            continue
        item = op_read(opvault, e["op_title"])
        if item and pin_map(e["name"], item["id"]):
            print(f"  pinned {e['name']}  op_id={item['id']}")
            n += 1
    print(f"\n{n} entr{'y' if n == 1 else 'ies'} pinned" if n else "nothing to pin (every existing item is pinned, or not created yet)")
    return 0


def split_1p(ref):
    item, sep, field = ref.partition("/")
    if not sep or not item or not field:
        raise Fatal(f"1P ref {ref!r} must be <item-uuid>/<field label> (append :text for a plain-text field)")
    return item, field


def split_vault(ref):
    path, sep, field = ref.rpartition("/")
    if not sep or not path or not field:
        raise Fatal(f"vault ref {ref!r} must be <path>/<field>, e.g. ansible/aiops/zabbix-token/value")
    return path, field


def cmd_mirror_to(args, opvault, mount, entries):
    """Ad-hoc single-field copy, no map entry needed: mirror-to <1p|vault> <src> [<dst>]."""
    to_op = args.dest == "1p"
    if args.dst is None:  # find the pairing in the map
        for e in entries:
            for vf, spec in e["fields"].items():
                label = parse_spec(spec)[0]
                if to_op and args.src == f"{e['vault_path']}/{vf}":
                    args.dst = f"{e.get('op_id') or e['op_title']}/{spec}"
                if not to_op and args.src.partition("/")[0] in (e.get("op_id"), e["op_title"]) \
                        and parse_spec(args.src.partition("/")[2])[0] == label:
                    args.dst = f"{e['vault_path']}/{vf}"
        if args.dst is None:
            raise Fatal("no destination given and the source is not in mirror-map.toml; "
                        "pass it: mirror-to <1p|vault> <src> <dst>")
    if to_op:
        vpath, vfield = split_vault(args.src)
        item, spec = split_1p(args.dst)
    else:
        item, spec = split_1p(args.src)
        vpath, vfield = split_vault(args.dst)
    if to_op and not args.title and op_read(opvault, item) is None:
        raise Fatal(f"1P item {item!r} not found; pass --title to create a new item")
    entry = {"name": "adhoc", "vault_path": vpath, "op_id": item, "op_title": args.title or item,
             "fields": {vfield: spec}}
    args.names, args.all = [], True
    return cmd_copy(args, opvault, mount, [entry], "to-1p" if to_op else "to-vault")


def preflight():
    for b in ("vault", "op"):
        if not shutil.which(b):
            for extra in ("/opt/homebrew/bin", "/usr/local/bin"):
                if Path(extra, b).exists():
                    os.environ["PATH"] += os.pathsep + extra
        if not shutil.which(b):
            raise Fatal(f"`{b}` not found on PATH")
    rc, _, err = run(["vault", "token", "lookup"])
    if rc != 0:
        raise Fatal(f"vault is not authenticated: {first_line(err)}  (source the shim: vault-homelab-env)")
    rc, _, err = run(["op", "vault", "list", "--format=json"])
    if rc != 0:
        raise Fatal(f"op is not signed in: {first_line(err)}  (run: op signin)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("status", "to-1p", "to-vault"):
        p = sub.add_parser(name)
        p.add_argument("names", nargs="*", help="mirror names from mirror-map.toml (default: all)")
        if name != "status":
            p.add_argument("--apply", action="store_true", help="really write (default is a dry run)")
            p.add_argument("--all", action="store_true", help="with --apply: confirm writing every entry")
            p.add_argument("--overwrite", action="store_true", help="replace a destination value that differs")
            p.add_argument("--allow-odd", action="store_true", help="allow whitespace/CR/trailing-newline values")
    sub.add_parser("unmapped", help="Vault paths and 1P Mirror items the map does not cover")
    sub.add_parser("pin", help="write op_id of every existing mapped item into the map")
    p = sub.add_parser("mirror-to", help="ad-hoc single field: mirror-to <1p|vault> <src> [<dst>]")
    p.add_argument("dest", choices=("1p", "vault"), help="which side is WRITTEN")
    p.add_argument("src", help="source: 1P '<uuid>/<field>' or vault '<path>/<field>'")
    p.add_argument("dst", nargs="?", help="destination, same forms; optional when the pair is in mirror-map.toml")
    p.add_argument("--apply", action="store_true", help="really write (default is a dry run)")
    p.add_argument("--overwrite", action="store_true", help="replace a destination value that differs")
    p.add_argument("--allow-odd", action="store_true", help="allow whitespace/CR/trailing-newline values")
    p.add_argument("--title", help="to 1p only: create the item with this title if it does not exist")
    args = ap.parse_args()
    try:
        opvault, mount, entries = load_map()
        preflight()
        if args.cmd == "status":
            return cmd_status(args, opvault, mount, entries)
        if args.cmd == "unmapped":
            return cmd_unmapped(args, opvault, mount, entries)
        if args.cmd == "pin":
            return cmd_pin(args, opvault, mount, entries)
        if args.cmd == "mirror-to":
            return cmd_mirror_to(args, opvault, mount, entries)
        return cmd_copy(args, opvault, mount, entries, args.cmd)
    except Fatal as ex:
        print(f"error: {ex}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
