#!/usr/bin/env python3
"""seed-discord-bot: put the Discord bot's values into Vault (and mirror them to 1Password) without typos.

Run it in YOUR OWN terminal (it prompts; the token is read with echo off and never printed):

    scripts/secrets/seed-discord-bot            # first time: prompts for the six values
    scripts/secrets/seed-discord-bot --check    # re-verify what is already in Vault against Discord, change nothing

What it does, in order:
  1. prompts for token, application id, server (guild) id, operator user id, and the two channel ids
     (on a re-run, Enter keeps the stored value);
  2. checks the SHAPE of each value (a token has three dot-separated parts, an id is 17-20 digits);
  3. asks Discord (read-only GETs) whether the token works, belongs to that application, is a member of the
     server, and can see both channels, so a wrong id or a missing permission is found now, not at 2 am;
  4. writes secret/ansible/ratatoskr/discord-bot in Vault (one `vault kv put|patch`, value as one argv element,
     read back and compared by SHA-256, only lengths and hash prefixes printed);
  5. mirrors the secret into 1Password with scripts/secrets/vault-1p-mirror (the repo's offline-mirror rule).

Needs: `vault` logged in with a token that can write secret/ansible/*, `op` signed in. Values you type never appear in
the process list for longer than the single vault call, and never in shell history (they are prompts, not arguments).
"""
import argparse
import getpass
import hashlib
import json
import re
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

PATH = "ansible/ratatoskr/discord-bot"
MOUNT = "secret"
MIRROR = Path(__file__).with_name("vault-1p-mirror")
UA = "DiscordBot (https://github.com/XIIISins/homelab, 1.0)"
API = "https://discord.com/api/v10"
SNOWFLAKE = re.compile(r"^\d{17,20}$")
TOKEN = re.compile(r"^[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{20,}$")
FIELDS = [  # (vault field, prompt, secret?, validator)
    ("token", "Bot token (Developer Portal > Bot > Reset Token)", True, lambda v: bool(TOKEN.match(v))),
    ("application_id", "Application ID (General Information)", False, lambda v: bool(SNOWFLAKE.match(v))),
    ("guild_id", "Server (guild) ID", False, lambda v: bool(SNOWFLAKE.match(v))),
    ("operator_user_id", "YOUR Discord user ID (the only account that may approve actions)", False, lambda v: bool(SNOWFLAKE.match(v))),
    ("diagnoses_channel_id", "#diagnoses forum channel ID", False, lambda v: bool(SNOWFLAKE.match(v))),
    ("chat_channel_id", "AIOps-chat channel ID", False, lambda v: bool(SNOWFLAKE.match(v))),
]


def sig(v: str) -> str:
    return f"len={len(v)} sha={hashlib.sha256(v.encode()).hexdigest()[:8]}"


def run(argv):
    p = subprocess.run(argv, capture_output=True, text=True, timeout=60)
    return p.returncode, p.stdout, p.stderr


def vault_read(path):
    rc, out, err = run(["vault", "kv", "get", "-format=json", f"-mount={MOUNT}", path])
    if rc != 0:
        if "No value found" in err:
            return None
        sys.exit(f"vault read failed: {err.strip().splitlines()[0][:200] if err.strip() else rc}")
    return {k: str(v) for k, v in json.loads(out)["data"]["data"].items()}


def vault_write(path, values, exists):
    for k, v in values.items():
        if v.startswith("@") or v == "-":
            sys.exit(f"{k} starts with '@' or is '-': the vault CLI would read a file/stdin. Not written.")
    verb = "patch" if exists else "put"
    rc, _, err = run(["vault", "kv", verb, f"-mount={MOUNT}", path] + [f"{k}={v}" for k, v in values.items()])
    if rc != 0:
        sys.exit(f"vault {verb} failed (can this identity write secret/{path}?)")


def discord(token, path):
    req = urllib.request.Request(API + path, headers={"Authorization": f"Bot {token}", "User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}
    except OSError as e:
        return 0, {"error": type(e).__name__}


def verify_with_discord(v):
    """Read-only GETs. Returns a list of problems (empty = everything checks out)."""
    problems = []
    st, me = discord(v["token"], "/users/@me")
    if st != 200:
        return [f"Discord rejected the token (HTTP {st}). Reset it in the Developer Portal and retry"]
    print(f"  token ok: bot user '{me.get('username')}' (id ends ...{str(me.get('id'))[-4:]})")
    if str(me.get("id")) != v["application_id"]:
        problems.append("application_id does not match the bot the token belongs to (a bot's user id equals its application id)")
    st, guilds = discord(v["token"], "/users/@me/guilds")
    if st != 200 or not any(str(g.get("id")) == v["guild_id"] for g in (guilds if isinstance(guilds, list) else [])):
        problems.append("the bot is not a member of that server: open the invite link and add it, or fix guild_id")
    for key, label in (("diagnoses_channel_id", "#diagnoses"), ("chat_channel_id", "AIOps-chat")):
        st, ch = discord(v["token"], f"/channels/{v[key]}")
        if st != 200:
            problems.append(f"the bot cannot see {label} (HTTP {st}): give the bot role View Channel there, or fix {key}")
        elif str(ch.get("guild_id")) != v["guild_id"]:
            problems.append(f"{label} is in a different server than guild_id")
        else:
            print(f"  channel ok: {label} (type {ch.get('type')}: 15 = forum, 0 = text)")
    return problems


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true", help="verify the stored values against Discord; change nothing")
    ap.add_argument("--path", default=PATH, help=argparse.SUPPRESS)
    ap.add_argument("--no-mirror", action="store_true", help="skip the 1Password mirror step")
    ap.add_argument("--no-discord", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args()

    stored = vault_read(args.path)
    if args.check:
        if not stored or any(k not in stored for k, *_ in FIELDS):
            sys.exit("nothing (or not everything) stored yet: run without --check")
        problems = [] if args.no_discord else verify_with_discord(stored)
        print("OK: every stored value checks out" if not problems else "\n".join("PROBLEM: " + p for p in problems))
        return 1 if problems else 0

    values = {}
    for key, label, secret, valid in FIELDS:
        have = (stored or {}).get(key)
        while True:
            hint = f" [Enter keeps the stored value, {sig(have)}]" if have else ""
            entered = (getpass.getpass if secret else input)(f"{label}{hint}: ").strip()
            if not entered and have:
                values[key] = have
                break
            if entered and valid(entered):
                values[key] = entered
                break
            print("  that does not look right, try again" if entered else "  a value is required")
    if not args.no_discord:
        print("checking with Discord (read-only):")
        problems = verify_with_discord(values)
        if problems:
            print("\n".join("PROBLEM: " + p for p in problems))
            sys.exit("nothing was written. Fix the above and re-run.")
    changed = {k: v for k, v in values.items() if (stored or {}).get(k) != v}
    if changed:
        vault_write(args.path, changed, stored is not None)
    back = vault_read(args.path) or {}
    bad = [k for k, v in values.items() if back.get(k) != v]
    if bad:
        sys.exit(f"read-back mismatch for {', '.join(bad)}: do not trust the stored values; re-run")
    print(f"Vault secret/{args.path}: {len(changed)} field(s) written, all {len(values)} verified by read-back")
    for k, v in values.items():
        print(f"  {k:<22} {sig(v)}")
    if args.no_mirror:
        return 0
    print("mirroring to 1Password:")
    rc = subprocess.run([sys.executable, str(MIRROR), "to-1p", "ratatoskr-discord-bot", "--apply"]).returncode
    if rc != 0:
        print("the 1Password mirror reported a problem (see above); the Vault copy is fine and verified")
    return rc


if __name__ == "__main__":
    sys.exit(main())
