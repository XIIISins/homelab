#!/usr/bin/env bash
# seed-burst-state-key: fill Vault secret/ansible/aiops/burst/env for the burst runner (Phase 10h; docs/procedures/k8s-burst-test.md).
#
#   digitalocean_token       copied from secret/ansible/frigg/iac-env (the shared custom-scope DO token; no second token to manage)
#   aws_access_key_id        terraform output burst_runner_state_access_key_id        (terraform/aws/burst-runner.tf)
#   aws_secret_access_key    terraform output burst_runner_state_secret_access_key    (sensitive)
#   aws_default_region       eu-west-1
#
# Run from the MAIN checkout, after `terraform apply` in terraform/aws, with the Vault shim loaded (VAULT_ADDR + a token that can write
# secret/ansible/aiops/burst/*) and the terraform/aws state reachable (it is the bootstrap layer; the state lives where the operator applies).
# Every value stays inside this process: nothing is printed, only "ok" lines and booleans. Re-running replaces the secret with the same
# fields (safe), and a re-minted key is picked up by running it again.
#
#   scripts/secrets/seed-burst-state-key            # write + verify
#   scripts/secrets/seed-burst-state-key --check    # verify only (read-only): are all four fields present and does the key look like an IAM key?
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
tf_dir="${TF_DIR:-$root/terraform/aws}"
path="secret/ansible/aiops/burst/env"
src="secret/ansible/frigg/iac-env"
mode="write"
[ "${1:-}" = "--check" ] && mode="check"

vget() { vault kv get -field="$2" "$1" 2>/dev/null || true; }
sum() { printf %s "$1" | shasum -a 256 | cut -d' ' -f1; }

if [ "$mode" = "write" ]; then
  do_token="$(vget "$src" digitalocean_token)"
  key_id="$(terraform -chdir="$tf_dir" output -raw burst_runner_state_access_key_id 2>/dev/null || true)"
  key_secret="$(terraform -chdir="$tf_dir" output -raw burst_runner_state_secret_access_key 2>/dev/null || true)"
  for v in do_token key_id key_secret; do
    if [ -z "${!v}" ]; then
      echo "missing: $v (is terraform apply done in terraform/aws, and is the Vault shim loaded?)" >&2
      exit 1
    fi
  done
  vault kv put "$path" digitalocean_token="$do_token" aws_access_key_id="$key_id" aws_secret_access_key="$key_secret" \
    aws_default_region=eu-west-1 >/dev/null
  echo "ok: wrote $path"
  # Hash-verify the read-back (a silent wrong value passes length checks).
  [ "$(sum "$(vget "$path" digitalocean_token)")" = "$(sum "$do_token")" ] || { echo "FAIL: digitalocean_token read-back differs" >&2; exit 1; }
  [ "$(sum "$(vget "$path" aws_access_key_id)")" = "$(sum "$key_id")" ] || { echo "FAIL: aws_access_key_id read-back differs" >&2; exit 1; }
  [ "$(sum "$(vget "$path" aws_secret_access_key)")" = "$(sum "$key_secret")" ] || { echo "FAIL: aws_secret_access_key read-back differs" >&2; exit 1; }
  echo "ok: read-back matches the sources (hashes only)"
fi

fail=0
for f in digitalocean_token aws_access_key_id aws_secret_access_key aws_default_region; do
  if [ -n "$(vget "$path" "$f")" ]; then echo "present: $f"; else echo "MISSING: $f"; fail=1; fi
done
case "$(vget "$path" aws_access_key_id)" in
  AKIA*) echo "ok: aws_access_key_id has the IAM key shape" ;;
  *) echo "WARN: aws_access_key_id does not look like an IAM access key"; fail=1 ;;
esac
exit "$fail"
