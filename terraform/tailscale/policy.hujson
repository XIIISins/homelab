// terraform/tailscale/policy.hujson
//
// Tailnet policy file. Edited by Terraform via tailscale_acl resource.
// HuJSON syntax: JSON + comments + trailing commas.
//
// Bootstrap state (manually planted via UI before terraform/tailscale/
// was created): tag:terraform-tag-owner exists, owns tag:subnet-router
// and tag:exit-node. This file expands the bootstrap to the full
// day-1 policy and Terraform takes ownership via import.

{
    // ---------------------------------------------------------------
    // Tag ownership
    // ---------------------------------------------------------------
    // - tag:terraform-tag-owner: empty owners list → only autogroup:admin
    //   (the operator) can apply this tag. The OAuth client carries
    //   this tag, which lets it (via Terraform) issue authkeys tagged
    //   with the child tags below.
    // - tag:subnet-router: applied to LXCs 1113/1114 + Munin. These
    //   devices advertise the homelab subnet (autoApprovers below).
    // - tag:exit-node: applied to LXC 1115. Advertises 0.0.0.0/0 + ::/0
    //   for off-LAN clients to use the homelab as a default route.
    "tagOwners": {
        "tag:terraform-tag-owner": [],
        "tag:subnet-router":       ["tag:terraform-tag-owner", "autogroup:admin"],
        "tag:exit-node":           ["tag:terraform-tag-owner"],
        // tag:server — Frigg (control-node watchtower VM). Joins only so
        // the operator can Tailscale-SSH in (ssh block below); advertises
        // nothing. autogroup:admin owner lets the operator re-tag if needed.
        "tag:server":              ["tag:terraform-tag-owner", "autogroup:admin"],
        // tag:offsite — do1, the DigitalOcean offsite node (Phase 10a): the
        // only public-internet-facing tailnet member (PlantNet proxy + TS3
        // failover + later the Gatus watcher). Gets NO blanket reach — see
        // the scoped grants below.
        "tag:offsite":             ["tag:terraform-tag-owner", "autogroup:admin"],
        // --- 10b2 burst substrate (tag:burst) -----------------------------
        // tag:burst — ephemeral DigitalOcean test clusters (terraform/digitalocean-burst).
        // Reachable FROM Frigg (tag:server) only; the node itself gets NO grant
        // anywhere, i.e. no path to prod. See docs/procedures/burst-substrate.md.
        "tag:burst":               ["tag:terraform-tag-owner", "autogroup:admin"],
        // --- end 10b2 ------------------------------------------------------
    },

    // ---------------------------------------------------------------
    // Access control rules
    // ---------------------------------------------------------------
    // Day-1: default-allow within the tailnet. All authenticated
    // members can reach all destinations (devices + advertised subnets).
    //
    // Reasoning: split-auth model already gates membership:
    //   - Servers join with indefinite authkeys minted by the operator
    //     (terraform/tailscale/ in 5e.3.e/f)
    //   - User devices join via Authentik OIDC, gated by tailscale-users
    //     group membership (5e.3.b PolicyBinding)
    // Within those bounds, default-allow is the simplest correct posture
    // for a single-admin homelab. Group-scoping (group:family with
    // restricted reach, etc.) is a future phase when other users land.
    //
    // Syntax: `grants` (Tailscale's current recommended syntax). Replaces
    // the legacy `acls` block. Grants are deny-by-default — each grant
    // only ADDS access (no `action` field since the only meaningful
    // value would be `accept`). `dst` and port are separated: `dst`
    // names destinations, `ip` names protocols+ports (or `["*"]` for
    // unrestricted). ACL-syntax compatibility is indefinite but `acls`
    // will not receive new features.
    //
    // 10a1 posture (replaces the day-1 allow-all `* -> *` above): everything
    // that was on the tailnet before keeps full reach (user devices, subnet
    // routers, the exit node, tag:server/Frigg), but `*` is no longer a
    // SOURCE, so the internet-facing tag:offsite node can reach only what is
    // granted explicitly below. Any NEW tag (e.g. tag:burst, 10b2) is
    // likewise default-deny until it gets a grant here.
    //
    // While the legacy droplet still carries the interim manual tag:server it
    // keeps the old wide reach; that ends when it is destroyed (10a3 cleanup).
    "grants": [
        {
            // dst `*` also lets these reach tag:offsite (operator SSH,
            // Frigg's Gatus heartbeat).
            "src": ["autogroup:member", "tag:subnet-router", "tag:exit-node", "tag:server"],
            "dst": ["*"],
            "ip":  ["*"],
        },
        // --- 10b2 burst substrate (tag:burst) -----------------------------
        // Frigg drives the burst clusters (kubectl :6443, SSH). Already covered by
        // the wide rule above; stated explicitly so the intent survives if that
        // rule is ever narrowed. tag:burst is deliberately NOT a src anywhere: a
        // burst node (a throwaway box for restore drills and fault injection)
        // can reach nothing, not prod and not other burst nodes. Cluster
        // traffic rides the DO VPC, never the tailnet.
        {
            "src": ["tag:server"],
            "dst": ["tag:burst"],
            "ip":  ["*"],
        },
        // --- end 10b2 ------------------------------------------------------
        // do1 -> Frigg: liveness probe for the outside watcher (Gatus, 10b3).
        // Port 22 is answered by tailscaled (Tailscale SSH) on Frigg; the ssh
        // block below only admits autogroup:member, so a probe can connect
        // but never log in.
        {
            "src": ["tag:offsite"],
            "dst": ["tag:server"],
            "ip":  ["tcp:22"],
        },
        // do1 -> Hermod (10.0.11.22, via the subnet routers): HTTP
        // reachability probe. Hermod's Caddy allowlist still decides what the
        // request may do. Tune ports with the gatus role (10b3).
        {
            "src": ["tag:offsite"],
            "dst": ["10.0.11.22"],
            "ip":  ["tcp:80"],
        },
    ],

    // ---------------------------------------------------------------
    // Auto-approvers — devices joining with the named tag auto-approve
    // their advertised routes / exit-node offering. Without this, every
    // route advertisement requires admin-console click-to-approve.
    // ---------------------------------------------------------------
    "autoApprovers": {
        "routes": {
            // 10.0.0.0/16 is the homelab supernet — covers every
            // current VLAN (mgmt 1, asgard-vip 10, asgard-svc 11,
            // asgard-k3s-vip 20, asgard-k3s-node 21, jotunheim-k3s-vip
            // 30, jotunheim-k3s-node 31, client 60, storage 100,
            // untrusted 222) plus any future /24 carved from 10.0.X.X.
            "10.0.0.0/16": ["tag:subnet-router"],
        },
        "exitNode": ["tag:exit-node"],
    },

    // ---------------------------------------------------------------
    // SSH (Tailscale SSH)
    // ---------------------------------------------------------------
    // Frigg (tag:server, Phase 6 Stage 2) accepts Tailscale SSH from any
    // tailnet member (single-admin tailnet today) as the local `ghost`
    // operator user — identity-based, no SSH-key management, reachable
    // from anywhere. `action: check` periodically re-verifies the
    // operator's tailnet identity (a god-tier control node warrants the
    // re-auth; flip to "accept" if the prompts become friction). `ghost`
    // has NOPASSWD sudo, so root is reachable without a direct root-SSH
    // rule. Broader host SSH (subnet-routers / exit-node, multi-user via
    // the ssh-users group) still lands with the future SSSD phase.
    "ssh": [
        {
            "action": "check",
            "src":    ["autogroup:member"],
            "dst":    ["tag:server"],
            "users":  ["ghost"],
        },
    ],
}
