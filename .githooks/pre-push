#!/usr/bin/env bash
# .githooks/pre-push — secret-scan every commit about to be pushed.
# Public repo: fail CLOSED (missing gitleaks blocks the push). Bypass only
# deliberately with `git push --no-verify`.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found — install it (brew install gitleaks) or push with --no-verify" >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                      # branch delete
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes"  # new branch
  else range="$rsha..$lsha"; fi
  echo "pre-push: gitleaks scanning ${range}" >&2
  gitleaks git --no-banner --redact --log-opts="$range" . || rc=1
done
[ "$rc" -eq 0 ] || { echo "pre-push: secrets detected — push blocked" >&2; exit 1; }
