#!/usr/bin/env bash
# .githooks/pre-push — secret-scan the entire repo before anything is pushed.
# Public repo: fail CLOSED (missing gitleaks blocks the push). Bypass only
# deliberately with `git push --no-verify`.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found — install it (brew install gitleaks) or push with --no-verify" >&2
  exit 1
fi

# Scan the ENTIRE repo (all commits on every ref, ~2 s at this size), not only the commits being pushed,
# so the local gate matches CI. The refs git feeds us only decide whether there is anything to push.
zero=0000000000000000000000000000000000000000
push=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] || push=1                        # a branch delete pushes no content
done
[ "$push" -eq 1 ] || exit 0
echo "pre-push: gitleaks scanning the entire repository" >&2
gitleaks git --no-banner --redact . || { echo "pre-push: secrets detected — push blocked" >&2; exit 1; }
