{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XIIISins/homelab/aiops/schema/actions.v1.schema.json",
  "title": "Action registry (aiops.actions/v1)",
  "description": "Every action the agent may ever take: a named entry mapping to one Semaphore template, with typed extra-vars, a tier, a guard, a verify step and a rollback note. No registry entry = no action. The executor (10e1) may trigger only the templates listed here; the playbooks re-enforce the guard independently of the executor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_tiers",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "aiops.actions/v1"
    },
    "host_tiers": {
      "description": "Inventory hostnames the mutating actions may target, by tier. Read by the playbooks (lookup of this file) AND by the agent. A host absent here is T2/T3 by default, i.e. never the target of a T1 action.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "T1"
      ],
      "properties": {
        "T1": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "T2": {
          "description": "Stateful or hard-to-replace hosts the rebuild section may name (approval-gated at best); never a target of a T1 action.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "autonomy": {
      "description": "The scope autonomous healing (10f) may act in. Runtime switches (autonomy on/off, kill switch, maintenance, breaker) live in the Toolbelt.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts",
        "limits",
        "policies"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": "Hosts an autonomous action may target; must be a subset of host_tiers.T1."
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "per_target_per_hour",
            "per_policy_per_day",
            "breaker_failures",
            "breaker_window_seconds"
          ],
          "properties": {
            "per_target_per_hour": {
              "type": "integer",
              "minimum": 1
            },
            "per_policy_per_day": {
              "type": "integer",
              "minimum": 1
            },
            "breaker_failures": {
              "type": "integer",
              "minimum": 1
            },
            "breaker_window_seconds": {
              "type": "integer",
              "minimum": 60
            }
          }
        },
        "policies": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/policy"
          }
        }
      }
    },
    "rebuild": {
      "description": "Phase 10g fleet rebuild loop: scope (classes, hosts, ladder stages), hard limits, deny list and policies. Policy data only; the runtime switch autonomy_rebuild lives in the Toolbelt and is off by default.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autonomy_rebuild_default",
        "limits",
        "dead",
        "broken",
        "stages",
        "classes",
        "deny",
        "policies"
      ],
      "properties": {
        "autonomy_rebuild_default": {
          "const": false
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "per_target_per_day",
            "per_target_per_week",
            "per_class_per_day",
            "fleet_per_day",
            "breaker_failures",
            "plan_max_age_seconds"
          ],
          "properties": {
            "per_target_per_day": {
              "type": "integer",
              "minimum": 1
            },
            "per_target_per_week": {
              "type": "integer",
              "minimum": 1
            },
            "per_class_per_day": {
              "type": "integer",
              "minimum": 1
            },
            "fleet_per_day": {
              "type": "integer",
              "minimum": 1
            },
            "breaker_failures": {
              "type": "integer",
              "minimum": 1
            },
            "plan_max_age_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "dead": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "probe_count",
            "probe_span_seconds",
            "backup_max_age_hours"
          ],
          "properties": {
            "probe_count": {
              "type": "integer",
              "minimum": 1
            },
            "probe_span_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "backup_max_age_hours": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "broken": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drift_max_changed"
          ],
          "properties": {
            "drift_max_changed": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "stages": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "A",
              "B1",
              "B2",
              "B3",
              "C"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "classes",
              "autonomy"
            ],
            "properties": {
              "classes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "autonomy": {
                "enum": [
                  "auto",
                  "approval-then-auto",
                  "approval"
                ]
              },
              "approvals_before_auto": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "classes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "kind",
              "module",
              "backup",
              "converge",
              "hosts",
              "post_conditions"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "A",
                  "B1",
                  "B2",
                  "B3",
                  "C"
                ]
              },
              "kind": {
                "enum": [
                  "lxc",
                  "droplet",
                  "k8s-worker"
                ]
              },
              "module": {
                "enum": [
                  "asgard-lxcs",
                  "asgard-lxcs-root",
                  "asgard-k3s",
                  "digitalocean"
                ]
              },
              "pool": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "backup": {
                "enum": [
                  "none",
                  "pbs-last-chance",
                  "manifest"
                ]
              },
              "converge": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "leader_aware": {
                "enum": [
                  "vrrp-master"
                ]
              },
              "neighbours": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "hosts": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "vmid",
                    "node"
                  ],
                  "properties": {
                    "vmid": {
                      "type": "integer",
                      "minimum": 100
                    },
                    "node": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    }
                  }
                }
              },
              "post_conditions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              }
            }
          }
        },
        "deny": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "names",
            "vmids"
          ],
          "properties": {
            "names": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              }
            },
            "vmids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "policies": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "action",
              "class",
              "runbook",
              "layers",
              "min_confidence",
              "precheck"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "action": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "class": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "runbook": {
                "type": "string",
                "pattern": "^RB-[A-Z0-9-]+$"
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "host",
                    "hypervisor",
                    "workload",
                    "network",
                    "drift",
                    "external"
                  ]
                }
              },
              "min_confidence": {
                "enum": [
                  "medium",
                  "high"
                ]
              },
              "precheck": {
                "enum": [
                  "guest-dead",
                  "guest-broken"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "var": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "boolean",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "pattern": {
          "type": "string",
          "description": "Full-match regex for string vars."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "default": {},
        "description": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "tier",
        "max_autonomy",
        "semaphore",
        "extra_vars",
        "guard",
        "verify",
        "rollback",
        "idempotent"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "scope": {
          "const": "rebuild",
          "description": "10g: the target must be a host in a rebuild class (and never on rebuild.deny); the engine refuses anything else before it runs."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "description": "10g: a multi-step flow run by toolbelt/rebuild_exec.py instead of one Semaphore task. Each step names a backend: `runner` (the Frigg rebuild runner, JSON over a unix socket; steps plan and apply) or `semaphore` (the default; the action's own template, or `action` for another registry action, with extra `vars`). The step named `verify` runs the class post-condition checklist.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "backend": {
                "enum": [
                  "runner",
                  "semaphore"
                ]
              },
              "action": {
                "type": "string"
              },
              "vars": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3"
          ]
        },
        "max_autonomy": {
          "description": "Ceiling the registry allows for this action. Stage gates (10e approval, 10f auto) decide what is actually enabled; raising a ceiling is a reviewed PR. T0 actions are read-only so they may be auto; every mutator starts at approval (or none) until the 10f1 guards exist.",
          "enum": [
            "none",
            "approval",
            "auto"
          ]
        },
        "idempotent": {
          "description": "true only if replaying the action is provably safe (see `idempotency`). Does not by itself raise max_autonomy.",
          "type": "boolean"
        },
        "idempotency": {
          "type": "string",
          "description": "Why replay is safe, citing the repo mechanism."
        },
        "semaphore": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applied"
          ],
          "if": {
            "required": [
              "runner_only"
            ],
            "properties": {
              "runner_only": {
                "const": true
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "template"
                  ]
                },
                {
                  "required": [
                    "playbook"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "template",
              "playbook"
            ]
          },
          "properties": {
            "runner_only": {
              "type": "boolean",
              "description": "10g: every step of the action runs on the Frigg rebuild runner (backend: runner), so there is no Semaphore template or playbook. `applied` then means the runner is deployed; lint requires all steps to be runner steps."
            },
            "template": {
              "type": "string",
              "description": "Semaphore template name; defined in terraform/semaphore/templates.tf."
            },
            "playbook": {
              "type": "string",
              "description": "Repo-relative playbook the template runs; must exist."
            },
            "applied": {
              "type": "boolean",
              "description": "false = defined in Terraform but not yet applied (operator gate)."
            },
            "result_from": {
              "enum": [
                "aiops_result",
                "recap"
              ],
              "description": "Where the executor reads the outcome: the playbook's AIOPS_RESULT line (default), or `recap` = ok/changed from the target host's PLAY RECAP line (for playbooks that cannot see their own stats)."
            },
            "task_fields": {
              "type": "object",
              "description": "Semaphore task fields the executor must set (not extra-vars). Values may reference extra_vars as {name}.",
              "additionalProperties": true
            },
            "planned": {
              "type": "boolean",
              "description": "true = the template and playbook are not written yet (planned in a phase doc); lint skips their existence checks. Requires applied: false."
            }
          }
        },
        "extra_vars": {
          "description": "Typed extra-vars the executor may pass (Semaphore task `environment`). Anything not declared here must be rejected by the executor.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/var"
          }
        },
        "fixed_vars": {
          "description": "Extra-vars the executor always sets to a constant (distinguishes actions sharing a template).",
          "type": "object"
        },
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "target_policy"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 10
            },
            "target_policy": {
              "enum": [
                "any-inventory-host",
                "host_tiers.T1",
                "n/a",
                "canaries"
              ]
            },
            "allowed_units": {
              "type": "object",
              "description": "host -> systemd units restart-unit may touch.",
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "allowed_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "allowed_releases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "denied_releases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requires_prior": {
              "type": "string",
              "description": "Another action that must have run (and succeeded) first."
            },
            "needs": {
              "type": "string",
              "description": "Tooling/credential the template relies on (documented, not enforced here)."
            },
            "pr_scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classes",
                "roles"
              ],
              "description": "10h2: the action runs a PR branch's code on a canary. The Toolbelt checks the PR itself (GitHub, read-only) before proposing and again before running: an agent PR of one of these classes, files only under ansible/roles/<role>/ for one of these roles, no deletions, no risky constructs in the added lines. The branch's own guard playbooks are never trusted.",
              "properties": {
                "classes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "verify": {
          "description": "Post-condition. `self` = the action's own AIOPS_RESULT must satisfy `expect`; `action` = run that (T0) action afterwards and require `expect` on its result.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expect"
          ],
          "properties": {
            "self": {
              "const": true
            },
            "action": {
              "type": "string"
            },
            "vars": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "expect": {
              "type": "object",
              "minProperties": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "self"
              ]
            },
            {
              "required": [
                "action"
              ]
            }
          ]
        },
        "rollback": {
          "type": "string",
          "minLength": 5
        },
        "internal": {
          "type": "boolean",
          "description": "10h2: only the Toolbelt itself proposes this action (source `author`); the diagnosis and chat agents are never told about it and a proposal from them is refused."
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "action",
        "runbook",
        "layers",
        "min_confidence",
        "precheck"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "description": "A T1 registry action; when enabled its max_autonomy must be auto."
        },
        "runbook": {
          "type": "string",
          "pattern": "^RB-[A-Z0-9-]+$",
          "description": "The diagnosis must name this runbook (an automatable: auto one)."
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "host",
              "hypervisor",
              "workload",
              "network",
              "drift",
              "external"
            ]
          }
        },
        "min_confidence": {
          "enum": [
            "medium",
            "high"
          ]
        },
        "precheck": {
          "enum": [
            "unit-not-active",
            "helmrelease-stalled",
            "drift-present"
          ],
          "description": "The Toolbelt's own read of reality that must confirm the fault before it acts."
        },
        "max_changed": {
          "type": "integer",
          "minimum": 1,
          "description": "drift-present only: the largest dry-run diff (changed tasks) it may converge on its own."
        }
      }
    }
  }
}
