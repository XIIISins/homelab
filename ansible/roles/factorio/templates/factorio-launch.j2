#!/bin/bash
# factorio-launch — start the Factorio dedicated server.
#
# Called from factorio.service. /opt/factorio is a symlink managed by
# factorio-reconcile and points at the currently-installed version's directory.
#
# RCON password: factorio only takes it inline (`--rcon-password <pw>`), which
# would put it in /proc/<pid>/cmdline for every local user to read. So:
#   - a fresh random password is generated on EVERY start (rotation), kept in
#     shell memory and written to {{ factorio_rconpw_path }} for local consumers;
#   - the binary is exec'd with libargvscrub.so preloaded, which zeroes the
#     password out of the process list before the game runs (see
#     files/argv-scrub.c). The password is never in this script's own argv.
# If the shim is missing, the server starts WITHOUT RCON rather than leak it.

set -euo pipefail

FACTORIO_BIN="/opt/factorio/bin/x64/factorio"
SERVER_SETTINGS="/factorio/config/server-settings.json"
SERVER_ADMINLIST="/factorio/config/server-adminlist.json"
SERVER_BANLIST="/factorio/config/server-banlist.json"
SERVER_WHITELIST="/factorio/config/server-whitelist.json"
RCON_PW_FILE="{{ factorio_rconpw_path }}"
ARGV_SCRUB_LIB="{{ factorio_argv_scrub_lib }}"

PORT="${FACTORIO_PORT:-34197}"
RCON_PORT="${FACTORIO_RCON_PORT:-27015}"

if [[ ! -x "$FACTORIO_BIN" ]]; then
    echo "factorio-launch: factorio binary missing at $FACTORIO_BIN" >&2
    echo "factorio-launch: factorio-reconcile may not have completed an install yet" >&2
    exit 1
fi

args=(
    --start-server-load-latest
    --server-settings "$SERVER_SETTINGS"
    --port "$PORT"
)

if [[ -r "$ARGV_SCRUB_LIB" && -w "$RCON_PW_FILE" ]]; then
    # Alphanumeric only, so the value can never be parsed as an option.
    RCON_PASSWORD="$(python3 -c 'import secrets, string; a = string.ascii_letters + string.digits; print("".join(secrets.choice(a) for _ in range(32)))')"
    # The file already exists (created by Ansible); truncating it in place
    # keeps owner/mode — the factorio user cannot create files in the 0750 dir.
    printf '%s\n' "$RCON_PASSWORD" > "$RCON_PW_FILE"
    args+=(--rcon-port "$RCON_PORT" --rcon-password "$RCON_PASSWORD")
    export LD_PRELOAD="$ARGV_SCRUB_LIB"
else
    echo "factorio-launch: $ARGV_SCRUB_LIB or $RCON_PW_FILE unusable; starting WITHOUT RCON" >&2
fi

# Optional list files — only pass if present, otherwise Factorio uses defaults.
[[ -f "$SERVER_ADMINLIST" ]] && args+=(--server-adminlist "$SERVER_ADMINLIST")
[[ -f "$SERVER_BANLIST"   ]] && args+=(--server-banlist "$SERVER_BANLIST")
[[ -f "$SERVER_WHITELIST" ]] && args+=(--server-whitelist "$SERVER_WHITELIST")

exec "$FACTORIO_BIN" "${args[@]}"
