{# ansible/roles/vlagent/templates/vlagent.service.j2 #}
{# vlagent takes ALL config via CLI flags (no YAML config file).
   -fileCollector.glob + -fileCollector.extraFields are array flags,
   passing each multiple times aligns by position to give per-file
   tags ({"host":"<host>","service":"<service>"}). #}
[Unit]
Description=vlagent — VictoriaLogs project log shipper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ vlagent_user }}
Group={{ vlagent_group }}
ExecStart={{ vlagent_binary }} \
    --remoteWrite.url='{{ vlagent_remote_write_url }}' \
    --remoteWrite.tmpDataPath={{ vlagent_data_dir }} \
    --remoteWrite.maxDiskUsagePerURL={{ vlagent_max_disk_usage_per_url }} \
    --fileCollector.checkpointsPath={{ vlagent_data_dir }}/file-checkpoints.json \
{% for input in vlagent_log_inputs %}
    --fileCollector.glob='{{ input.path }}' \
    --fileCollector.extraFields='{"host":"{{ vlagent_host_label }}","service":"{{ input.service | default("unknown") }}"}' \
{% endfor %}
    --loggerOutput=stderr \
    --loggerLevel=INFO
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Modest hardening
NoNewPrivileges=true
ProtectHome=true
PrivateDevices=true
ReadWritePaths={{ vlagent_data_dir }} {{ vlagent_log_dir }}

[Install]
WantedBy=multi-user.target
