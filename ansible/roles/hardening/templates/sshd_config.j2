# ansible/roles/hardening/templates/sshd_config.j2
# Managed by Ansible — do not edit manually
# {{ ansible_managed }}

Port {{ ssh_port }}
AddressFamily inet
ListenAddress 0.0.0.0

# Authentication
PermitRootLogin {{ ssh_permit_root_login }}
PasswordAuthentication {{ ssh_password_authentication }}
PubkeyAuthentication {{ ssh_pubkey_authentication }}
AuthorizedKeysFile .ssh/authorized_keys
PermitEmptyPasswords no
ChallengeResponseAuthentication no

# Security
X11Forwarding no
AllowAgentForwarding no
AllowTcpForwarding yes
MaxAuthTries 3
MaxSessions 5
LoginGraceTime 30

# Logging
SyslogFacility AUTHPRIV
LogLevel VERBOSE

# Banner
Banner /etc/issue.net

# Keep connections alive
ClientAliveInterval 300
ClientAliveCountMax 2

# Use strong algorithms only
KexAlgorithms curve25519-sha256,curve25519-sha256@libssh.org
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# Allow ansible and recovery users (+ any host-specific extras, e.g. the
# operator user on the control node). Personal users elsewhere are added
# via SSSD/Authentik.
AllowUsers ansible {{ breakglass_user }}{% for u in ssh_extra_allow_users | default([]) %} {{ u }}{% endfor %}

