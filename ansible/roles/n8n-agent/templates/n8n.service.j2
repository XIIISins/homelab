# Managed by Ansible - roles/n8n-agent. Do not edit by hand.
[Unit]
Description=n8n (AIOps diagnosis agent, loopback listener)
Documentation=https://docs.n8n.io/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User={{ n8n_user }}
Group={{ n8n_group }}
EnvironmentFile={{ n8n_env_path }}
Environment=PATH={{ n8n_node_link }}/bin:/usr/bin:/bin
Environment=HOME={{ n8n_data_dir }}
WorkingDirectory={{ n8n_data_dir }}
ExecStart={{ n8n_node_link }}/bin/node {{ n8n_app_dir }}/node_modules/n8n/bin/n8n start
Restart=always
RestartSec=10
TimeoutStopSec=30

# Hardening: unprivileged, no capabilities, read-only filesystem except n8n's
# own state directory. MemoryDenyWriteExecute is deliberately NOT set: V8's JIT
# needs writable+executable pages and Node fails to start under it.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ n8n_data_dir }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryMax={{ n8n_memory_max }}
TasksMax=512

[Install]
WantedBy=multi-user.target
