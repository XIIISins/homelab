# Managed by Ansible - roles/n8n-agent. Do not edit by hand. 0600 n8n:n8n.
# Secrets in here: the post-only #diagnoses webhook, the owner password HASH.
# The encryption key is a file (N8N_ENCRYPTION_KEY_FILE), not an env var.

# ---- Where things live -------------------------------------------------------
N8N_USER_FOLDER={{ n8n_data_dir }}
N8N_ENCRYPTION_KEY_FILE={{ n8n_config_dir }}/encryption-key

# ---- Listener (loopback only; Caddy fronts /webhook/* from allowlisted IPs) --
N8N_HOST={{ n8n_listen_host }}
N8N_LISTEN_ADDRESS={{ n8n_listen_host }}
N8N_PORT={{ n8n_listen_port }}
N8N_PROTOCOL=http
# Editor is only reached through an SSH tunnel to loopback, so the Secure
# cookie flag (HTTPS-only) would just break login on Safari.
N8N_SECURE_COOKIE=false
# Production webhook URLs as monitoring systems see them (Caddy ingest listener).
WEBHOOK_URL=http://gna.niflheim.xiiisins.com:8081/

# ---- Owner, from env (no first-run UI step) ----------------------------------
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL={{ n8n_owner_email }}
N8N_INSTANCE_OWNER_FIRST_NAME=AIOps
N8N_INSTANCE_OWNER_LAST_NAME=Agent
N8N_INSTANCE_OWNER_PASSWORD_HASH='{{ n8n_owner_hash }}'

# ---- Surface reduction -------------------------------------------------------
NODES_EXCLUDE='{{ n8n_nodes_exclude | to_json }}'
N8N_PUBLIC_API_DISABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_METRICS=false
# Workflows read the Discord webhook with {{ '{{ $env.AIOPS_DISCORD_URL }}' }}. That needs $env
# enabled in expressions; the cost is that a workflow can read the rest of this
# file's variables too, which is why the encryption key is a file and why the
# only secret left here is a post-only webhook (see docs/procedures/aiops-diagnosis.md).
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
AIOPS_DISCORD_URL={{ n8n_discord_url }}
AIOPS_TOOLBELT_URL={{ n8n_toolbelt_url }}

# ---- Execution history = audit trail -----------------------------------------
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
N8N_PAYLOAD_SIZE_MAX=2

# ---- Logs go to the journal (vlagent ships them) -----------------------------
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
TZ=UTC
GENERIC_TIMEZONE=UTC
