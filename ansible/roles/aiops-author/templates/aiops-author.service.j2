{# ansible/roles/aiops-author/templates/aiops-author.service.j2 #}
# Managed by Ansible (roles/aiops-author). Do not edit.
[Unit]
Description=AIOps PR author dispatcher (claims approved change requests, publishes checked patches as pull requests)
Documentation=https://github.com/XIIISins/homelab/blob/main/docs/procedures/aiops-author.md
After=network-online.target {{ aiops_author_creds_unit_name }}.service {{ aiops_toolbelt_unit_name | default('aiops-toolbelt') }}.service
Wants=network-online.target
Requires={{ aiops_author_creds_unit_name }}.service
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ aiops_author_user }}
# The dispatcher's group is the drafting user's group: job directories it creates are group-writable for the session.
Group={{ aiops_author_draft_user }}
StateDirectory={{ aiops_author_state_dir_name }}
StateDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 {{ aiops_author_home }}/aiops/author/dispatcher.py \
  --toolbelt {{ aiops_author_toolbelt_url }} \
  --author-token-file {{ aiops_author_creds_dir }}/author-token \
  --tools-token-file {{ aiops_author_creds_dir }}/tools-token \
  --pat-file {{ aiops_author_creds_dir }}/pat \
  --anthropic-file {{ aiops_author_creds_dir }}/anthropic \
  --askpass {{ aiops_author_askpass_path }} \
  --classes {{ aiops_author_home }}/aiops/author-classes.yml \
  --tools-cli {{ aiops_author_home }}/aiops/author/toolcli.py \
  --agent-file {{ aiops_author_home }}/aiops/author/agent.md \
  --work {{ aiops_author_work }} \
  --repo {{ aiops_author_repo }} \
  --max-budget-usd {{ aiops_author_max_budget_usd }} \
  --max-parallel {{ aiops_author_max_parallel }}{% if aiops_author_model %} \
  --model {{ aiops_author_model }}{% endif %}{% if aiops_author_allow_admin_token %} \
  --allow-admin-token{% endif %}{% if aiops_author_dry_run %} \
  --dry-run{% endif %}

ExecStopPost=+/bin/rm -rf {{ aiops_author_creds_dir }}
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ aiops_author_unit_name }}

# No LLM runs here; it holds the GitHub token. It may reach the Toolbelt (Frigg itself) and the internet (GitHub); every
# private range is denied. (IPAddressAllow beats IPAddressDeny for an address in both.)
IPAddressDeny={{ aiops_author_deny_ranges | join(' ') }} 169.254.0.0/16 fc00::/7 fe80::/10
IPAddressAllow=127.0.0.0/8 {{ aiops_author_toolbelt_ip }} {{ aiops_author_dns_allow | join(' ') }}
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0007
LimitCORE=0

[Install]
WantedBy=multi-user.target
