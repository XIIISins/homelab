{# ansible/roles/aiops-author/templates/aiops-draft-launch.path.j2 #}
# Managed by Ansible (roles/aiops-author). Do not edit.
[Unit]
Description=AIOps drafting-session launch markers

[Path]
# One fixed directory (always present), not a glob over per-job directories: a glob needs a watch on each new job directory and
# misses a marker written before that watch exists.
DirectoryNotEmpty={{ aiops_author_work }}/markers
Unit={{ aiops_author_launch_unit_name }}.service

[Install]
WantedBy=multi-user.target
