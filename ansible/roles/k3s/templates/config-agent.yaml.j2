# ansible/roles/k3s/templates/config-agent.yaml.j2
# K3s config for worker nodes ({{ inventory_hostname }})
# Worker nodes run workloads but don't participate in etcd or the control plane

server: "https://{{ k3s_join_host }}:6443"
token: "{{ k3s_token }}"
{% if k3s_node_ip is defined %}
node-ip: "{{ k3s_node_ip }}"
{% endif %}

# SELinux support
selinux: {{ k3s_selinux | bool | lower }}

{% if k3s_worker_kubelet_args | length > 0 %}
kubelet-arg:
{% for arg in k3s_worker_kubelet_args %}
  - "{{ arg }}"
{% endfor %}
{% endif %}
