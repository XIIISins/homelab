# Managed by Ansible — roles/gatus. Do not edit by hand.
# Co-location mitigation (10a2/10b3): containers on this host must not reach the
# Gatus listener on the host's own tailnet address. DOCKER-USER only sees
# FORWARDed traffic; container -> host-address traffic traverses INPUT.
[Unit]
Description=Drop container-bridge traffic to the Gatus tailnet listener
After=network-pre.target
Before=gatus.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -s {{ gatus_container_cidr }} -d {{ gatus_listen_address }}/32 -p tcp --dport {{ gatus_listen_port }} -j DROP 2>/dev/null || /usr/sbin/iptables -I INPUT 1 -s {{ gatus_container_cidr }} -d {{ gatus_listen_address }}/32 -p tcp --dport {{ gatus_listen_port }} -j DROP'
ExecStop=-/usr/sbin/iptables -D INPUT -s {{ gatus_container_cidr }} -d {{ gatus_listen_address }}/32 -p tcp --dport {{ gatus_listen_port }} -j DROP

[Install]
WantedBy=multi-user.target
