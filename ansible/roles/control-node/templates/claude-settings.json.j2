{
  "_comment": "ansible/roles/control-node/templates/claude-settings.json.j2 — Managed by Ansible. Conservative allow-list so a mobile remote-control session is not prompt-stormed on routine READ-ONLY ops. Anything mutating (terraform apply, git push, kubectl apply, rm, ansible-playbook without --check) deliberately still prompts.",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git worktree list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt -check:*)",
      "Bash(terraform show:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform output:*)",
      "Bash(terraform providers:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl top:*)",
      "Bash(flux get:*)",
      "Bash(flux check:*)",
      "Bash(flux tree:*)",
      "Bash(helm list:*)",
      "Bash(helm status:*)",
      "Bash(helm get:*)",
      "Bash(helm show:*)",
      "Bash(vault kv list:*)",
      "Bash(vault token lookup:*)",
      "Bash(vault read sys/health:*)",
      "Bash(ansible-playbook --check:*)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(ansible-inventory --graph:*)",
      "Bash(ansible-lint:*)",
      "Bash(yamllint:*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(vault kv get:*)",
      "Read(./**/*.tfstate)",
      "Read(./**/secrets/**)",
      "Read(./**/*vault*.yml)"
    ]
  }
}
