{# ansible/roles/hermod-api/templates/homelab.yml.j2 #}
{# Apprise config — tag-driven routing to Discord channels. One URL
   per tag; sources tag the notification, Apprise fans to every
   matching URL. Render-time Vault lookup pulls Discord webhook
   id/token per channel from secret/ansible/hermod/discord/<tag>.
   Adding new delivery destinations is one URL block per tag — no
   source-side changes required. #}
urls:
{% for w in hermod_api_discord_webhooks %}
{% set creds = lookup('community.hashi_vault.vault_kv2_get', w.vault_path).secret %}
  - url: discord://{{ creds.id }}/{{ creds.token }}/?format=markdown{% if w.mention %}&mention={{ w.mention | urlencode }}{% endif %}
    tag: {{ w.tag }}
{% endfor %}
