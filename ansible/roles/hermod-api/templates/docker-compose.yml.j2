{# ansible/roles/hermod-api/templates/docker-compose.yml.j2 #}
{# caronc/apprise — single-container AppriseAPI deploy. Stateless;
   config mounted from /etc/apprise; logs to stdout (journald via
   Docker's journald log driver — picked up by vlagent later). #}
services:
  apprise:
    image: {{ hermod_api_image }}
    container_name: apprise
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ hermod_api_listen_port }}:8000"  # bind to loopback inside-host; nginx-style reverse proxying could front this later
      - "{{ hermod_api_listen_port }}:8000"            # also bind on all interfaces for direct LAN access (VLAN 11 internal)
    environment:
      APPRISE_CONFIG_DIR: /config
      APPRISE_STATEFUL_MODE: simple  # single-file config-key shape
      # APPRISE_DEFAULT_THEME, APPRISE_DENY_SERVICES, etc. — see upstream docs
    volumes:
      - {{ hermod_api_config_dir }}:/config:ro
    logging:
      driver: journald
      options:
        tag: apprise
