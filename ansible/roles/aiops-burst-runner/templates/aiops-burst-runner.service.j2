{# ansible/roles/aiops-burst-runner/templates/aiops-burst-runner.service.j2 #}
# Managed by Ansible (roles/aiops-burst-runner). Do not edit.
[Unit]
Description=AIOps burst runner (throwaway burst-cluster tests of agent k8s PRs)
Documentation=https://github.com/XIIISins/homelab/blob/main/docs/procedures/k8s-burst-test.md
After=network-online.target {{ aiops_burst_runner_creds_unit_name }}.service {{ aiops_burst_runner_agent_unit_name }}.service
Wants=network-online.target
Requires={{ aiops_burst_runner_creds_unit_name }}.service {{ aiops_burst_runner_agent_unit_name }}.service
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ aiops_burst_runner_user }}
# The primary group is the CLIENTS group: the runtime directory (and so the path to the socket) is then reachable by exactly that group, while the
# state directory stays 0700 (owner only).
Group={{ aiops_burst_runner_group }}
RuntimeDirectory={{ aiops_burst_runner_runtime_dir_name }}
RuntimeDirectoryMode=0750
StateDirectory={{ aiops_burst_runner_state_dir_name }}
StateDirectoryMode=0700
Environment=PYTHONDONTWRITEBYTECODE=1
# Credentials: written by the root loader (a dependency, re-run on every start); injected by systemd, unreadable by this user.
EnvironmentFile={{ aiops_burst_runner_env_file }}
ExecStart=/usr/bin/python3 {{ aiops_burst_runner_home }}/aiops/runner/burst_runner.py \
  --socket {{ aiops_burst_runner_socket }} \
  --socket-group {{ aiops_burst_runner_group }} \
  --checkout /var/lib/{{ aiops_burst_runner_state_dir_name }}/checkout \
  --state-dir /var/lib/{{ aiops_burst_runner_state_dir_name }} \
  --timeout {{ aiops_burst_runner_timeout }} \
{% for u in aiops_burst_runner_clients %}
  --allow-user {{ u }} \
{% endfor %}
  --repo-url {{ aiops_burst_runner_repo_url }}
ExecStopPost=+/bin/rm -f {{ aiops_burst_runner_env_file }}
Restart=on-failure
RestartSec=20
TimeoutStopSec=1500
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aiops-burst-runner

# No IPAddressDeny: the harness reaches DigitalOcean, the S3 state backend, GitHub, the provider registries and the burst cluster over the tailnet.
# What bounds it instead is the credentials it holds (a burst-scoped DO token, a state-only AWS identity), what it accepts (an agent k8s branch,
# a full sha, an app name) and that the code it runs is its own clean checkout of main, never the PR's.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
