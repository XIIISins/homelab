{# ansible/roles/zabbix-server/templates/nginx.conf.j2 #}
{# Zabbix frontend nginx site. Replaces the default zabbix-nginx-conf
   ships at the same path. listen on port {{ zabbix_web_listen_port }}
   (default 80). server_name lists every Host header Traefik may
   forward upstream (see zabbix_web_server_names in defaults). #}
server {
    listen          {{ zabbix_web_listen_port }};
    server_name     {{ zabbix_web_server_names | join(' ') }};

    root /usr/share/zabbix;

    index index.php;

    location = /favicon.ico {
        log_not_found off;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location /assets {
        access_log off;
        expires 10d;
    }

    location ~ /\.ht {
        deny all;
    }

    location ~ /(api\/|conf[^\.]|include|locale|vendor) {
        deny all;
        return 404;
    }

    location /vendor {
        deny all;
        return 404;
    }

    {# Localhost-only monitoring endpoints (Zabbix agent fetches them
       via web.page.get / web.page.regexp from 127.0.0.1).
       - /basic_status — nginx `stub_status` for the Nginx-by-Zabbix-agent
         template.
       - /status + /ping — proxied to PHP-FPM's status + ping endpoints
         for the PHP-FPM-by-Zabbix-agent template. The agent fetches
         them as HTTP from localhost:80; nginx FastCGI-proxies them
         into the PHP-FPM unix socket. #}
    location = /basic_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
        access_log off;
    }

    location ~ ^/(status|ping)$ {
        allow 127.0.0.1;
        deny all;
        access_log off;
        fastcgi_pass unix:/run/php/zabbix.sock;
        fastcgi_param SCRIPT_FILENAME $fastcgi_script_name;
        include fastcgi_params;
    }

    {# Scheme reflection for the reverse-proxy path. Traefik terminates
       TLS, forwards plain HTTP to nginx:80, and sets X-Forwarded-Proto.
       Zabbix's PHP frontend builds absolute URLs (including the SAML
       AssertionConsumerServiceURL) from $_SERVER['HTTPS']. Without
       this, SAML AuthnRequests carry http://... ACS URLs which
       Authentik rejects ("ACS URL doesn't match provider ACS URL").
       Backdoor (hugin-direct.niflheim) sends no XFF header → keeps
       HTTPS=off, which is correct for the plaintext path. #}
    set $forwarded_https "off";
    if ($http_x_forwarded_proto = "https") {
        set $forwarded_https "on";
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_pass    unix:/run/php/zabbix.sock;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_index   index.php;

        fastcgi_param   DOCUMENT_ROOT   /usr/share/zabbix;
        fastcgi_param   SCRIPT_FILENAME /usr/share/zabbix$fastcgi_script_name;
        fastcgi_param   PATH_TRANSLATED /usr/share/zabbix$fastcgi_script_name;

        include fastcgi_params;
        fastcgi_param   QUERY_STRING    $query_string;
        fastcgi_param   REQUEST_METHOD  $request_method;
        fastcgi_param   CONTENT_TYPE    $content_type;
        fastcgi_param   CONTENT_LENGTH  $content_length;
        fastcgi_param   HTTPS           $forwarded_https;

        fastcgi_intercept_errors        on;
        fastcgi_ignore_client_abort     off;
        fastcgi_connect_timeout         60;
        fastcgi_send_timeout            180;
        fastcgi_read_timeout            180;
        fastcgi_buffer_size             128k;
        fastcgi_buffers                 4 256k;
        fastcgi_busy_buffers_size       256k;
        fastcgi_temp_file_write_size    256k;
    }
}
