{# ansible/roles/frigg-ssh-agent/templates/frigg-ssh-agent.service.j2 #}
# Managed by Ansible (roles/frigg-ssh-agent). Do not edit.
[Unit]
Description=Frigg ssh-agent (fleet ansible key, memory only)
Documentation=https://github.com/XIIISins/homelab/blob/main/docs/known-issues/frigg-control-node.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ frigg_ssh_agent_user }}
RuntimeDirectory={{ frigg_ssh_agent_runtime_dir_name }}
RuntimeDirectoryMode=0700
Environment=SSH_AUTH_SOCK={{ frigg_ssh_agent_socket }}
Environment=VAULT_ADDR={{ frigg_ssh_agent_vault_addr }}
Environment=FRIGG_SSH_AGENT_APPROLE_ENV={{ frigg_ssh_agent_approle_env_path }}
Environment=FRIGG_SSH_AGENT_KEY_PATH={{ frigg_ssh_agent_key_vault_path }}
Environment=FRIGG_SSH_AGENT_KEY_FIELD={{ frigg_ssh_agent_key_field }}
Environment=FRIGG_SSH_AGENT_PUB_PATH={{ frigg_ssh_agent_pub_path }}
Environment=FRIGG_SSH_AGENT_PUB_OWNER={{ frigg_ssh_agent_user }}
ExecStart=/usr/bin/ssh-agent -D -a {{ frigg_ssh_agent_socket }}
# The `+` runs the loader as root OUTSIDE this unit's sandbox: it needs the root-only
# AppRole file and network access to Vault, which the agent process itself must not have.
# Lesson from Gatus (known-issues/digitalocean.md): sandbox options also confine helpers
# unless they are `+`-prefixed. A loader failure fails the start, so Restart= retries and
# the agent is never up-but-empty.
ExecStartPost=+/usr/bin/env python3 {{ frigg_ssh_agent_loader_path }}
Restart=on-failure
RestartSec=30
TimeoutStartSec=120

# The agent only needs its unix socket.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
