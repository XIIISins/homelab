{# ansible/roles/aiops-toolbelt/templates/aiops-toolbelt.service.j2 #}
# Managed by Ansible (roles/aiops-toolbelt). Do not edit.
[Unit]
Description=AIOps Toolbelt API (read-only door for the diagnosis agent)
Documentation=https://github.com/XIIISins/homelab/blob/main/docs/operations/10d-diagnosis-chatops.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ aiops_toolbelt_user }}
Group={{ aiops_toolbelt_user }}
{% if aiops_toolbelt_rebuild_socket or aiops_toolbelt_burst_socket %}
SupplementaryGroups={{ (([aiops_toolbelt_rebuild_group] if aiops_toolbelt_rebuild_socket else []) + ([aiops_toolbelt_burst_group] if aiops_toolbelt_burst_socket else [])) | join(' ') }}
{% endif %}
StateDirectory=aiops-toolbelt
StateDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
# The loader is its own unit (aiops-toolbelt-token.service): it needs the root-only
# AppRole file and Vault access, which this process must never have, and this unit's
# IPAddressDeny= would block it even under `+`. Restarting it here refreshes the token
# on every start; a loader failure fails this start (Restart= retries), so the API is
# never up without a token.
ExecStartPre=+/usr/bin/systemctl restart {{ aiops_toolbelt_token_unit_name }}.service
ExecStart=/usr/bin/python3 {{ aiops_toolbelt_home }}/aiops/toolbelt/server.py \
  --listen {{ aiops_toolbelt_listen_host }}:{{ aiops_toolbelt_listen_port }} \
  --db /var/lib/aiops-toolbelt/toolbelt.sqlite3 \
  --token-file {{ aiops_toolbelt_token_file }} \
{% for cidr in aiops_toolbelt_allow %}
  --allow {{ cidr }} \
{% endfor %}
{% if aiops_toolbelt_actions_enabled %}
  --actions \
  --approver-token-file {{ aiops_toolbelt_approver_token_file }} \
{% for cidr in aiops_toolbelt_approver_allow %}
  --approver-allow {{ cidr }} \
{% endfor %}
  --operators-file {{ aiops_toolbelt_operators_file }} \
{% if aiops_toolbelt_change_requests_enabled %}
  --change-requests \
  --author-token-file {{ aiops_toolbelt_author_token_file }} \
  --author-tools-token-file {{ aiops_toolbelt_author_tools_token_file }} \
{% for cidr in aiops_toolbelt_author_allow %}
  --author-allow {{ cidr }} \
  --author-tools-allow {{ cidr }} \
{% endfor %}
  --author-daily-budget {{ aiops_toolbelt_author_daily_budget }} \
  --github-read-url http://127.0.0.1:{{ aiops_toolbelt_ghread_port }} \
{% if aiops_toolbelt_auto_incident_drafts %}
  --auto-incident-drafts \
{% endif %}
{% endif %}
  --exec-cred {{ aiops_toolbelt_exec_cred }} \
{% if aiops_toolbelt_rebuild_socket %}
  --rebuild-socket {{ aiops_toolbelt_rebuild_socket }} \
{% endif %}
{% if aiops_toolbelt_burst_socket %}
  --burst-socket {{ aiops_toolbelt_burst_socket }} \
{% endif %}
{% if aiops_toolbelt_soak %}
  --soak \
{% endif %}
{% endif %}
  --replay-dir {{ aiops_toolbelt_replay_dir }} \
{% if aiops_toolbelt_forecast_enabled %}
  --forecast-current {{ aiops_toolbelt_forecast_current }} \
{% endif %}
  --repo-dir {{ aiops_toolbelt_repo_dir }} \
  --creds-dir {{ aiops_toolbelt_creds_dir }} \
  --placement-file {{ aiops_toolbelt_placement_file }} \
  --daily-run-cap {{ aiops_toolbelt_daily_run_cap }}
Restart=on-failure
RestartSec=10

# The process may only talk to its callers and, for the reach.tcp probe, the homelab ranges.
# Both directions; never the internet.
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
# Frigg itself, so the role's own anonymous-probe checks reach the listener. The app-level
# allow-list still refuses it for every route but /healthz.
IPAddressAllow={{ aiops_toolbelt_listen_host }}
{% for cidr in aiops_toolbelt_allow + (aiops_toolbelt_approver_allow if aiops_toolbelt_actions_enabled else []) + aiops_toolbelt_egress_allow %}
IPAddressAllow={{ cidr }}
{% endfor %}
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET{{ ' AF_UNIX' if (aiops_toolbelt_rebuild_socket or aiops_toolbelt_burst_socket) else '' }}
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
