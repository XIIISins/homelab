{# ansible/roles/aiops-toolbelt/templates/aiops-toolbelt-forecast.service.j2 #}
# Managed by Ansible (roles/aiops-toolbelt). Do not edit.
# One SHADOW forecasting pass (Phase 10h1): reads VictoriaMetrics through the same metrics-read route the agent's read tool
# uses, runs the slow-fill and fast-rise detectors and appends findings to a local JSONL file. No Discord, ticket or Hermod
# output exists in this slice. Its own unit: the API unit has no route to the metrics endpoint by design (IPAddressDeny=any).
# docs/procedures/aiops-forecasting.md
[Unit]
Description=AIOps Toolbelt forecasting shadow pass (VictoriaMetrics -> local JSONL)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ aiops_toolbelt_user }}
Group={{ aiops_toolbelt_user }}
StateDirectory=aiops-toolbelt
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 {{ aiops_toolbelt_home }}/aiops/toolbelt/forecast_run.py --log {{ aiops_toolbelt_forecast_log }} --state {{ aiops_toolbelt_forecast_state }} --url {{ aiops_toolbelt_forecast_metrics_url }}
TimeoutStartSec=300
Environment=PYTHONDONTWRITEBYTECODE=1

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
UMask=0027
