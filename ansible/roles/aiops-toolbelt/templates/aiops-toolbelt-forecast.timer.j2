{# ansible/roles/aiops-toolbelt/templates/aiops-toolbelt-forecast.timer.j2 #}
# Managed by Ansible (roles/aiops-toolbelt). Do not edit.
[Unit]
Description=AIOps forecasting pass every {{ aiops_toolbelt_forecast_interval }}

[Timer]
OnBootSec=10min
OnUnitActiveSec={{ aiops_toolbelt_forecast_interval }}
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
