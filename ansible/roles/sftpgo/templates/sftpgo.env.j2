# /etc/sftpgo/sftpgo.env — managed by Ansible (sftpgo role)
# Don't hand-edit; changes get reverted on next playbook run.
#
# All SFTPGo config can be expressed as env vars by prefixing keys with
# SFTPGO_ and using __ to traverse nested structures.

# ============================================================================
# Admin bootstrap — takes effect only on first start when no admin exists.
# Subsequent runs ignore these.
# ============================================================================
SFTPGO_DATA_PROVIDER__CREATE_DEFAULT_ADMIN=true
SFTPGO_DEFAULT_ADMIN_USERNAME={{ sftpgo_admin_username }}
SFTPGO_DEFAULT_ADMIN_PASSWORD={{ sftpgo_admin_password_effective }}

# ============================================================================
# SFTP service
# ============================================================================
SFTPGO_SFTPD__BINDINGS__0__ADDRESS={{ sftpgo_sftp_bind_address }}
SFTPGO_SFTPD__BINDINGS__0__PORT={{ sftpgo_sftp_bind_port }}

# ============================================================================
# HTTP service (web admin + web client)
# ============================================================================
{% if sftpgo_web_admin_enabled %}
SFTPGO_HTTPD__BINDINGS__0__ADDRESS={{ sftpgo_web_admin_bind_address }}
SFTPGO_HTTPD__BINDINGS__0__PORT={{ sftpgo_web_admin_bind_port }}
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_ADMIN=true
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_CLIENT={{ sftpgo_web_client_enabled | ternary('true', 'false') }}
{% else %}
# Web admin disabled — bind to localhost on an unused port and disable both UIs.
SFTPGO_HTTPD__BINDINGS__0__ADDRESS=127.0.0.1
SFTPGO_HTTPD__BINDINGS__0__PORT=0
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_ADMIN=false
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_CLIENT=false
{% endif %}

{% if sftpgo_web_client_enabled and (sftpgo_web_admin_bind_port != sftpgo_web_client_bind_port or sftpgo_web_admin_bind_address != sftpgo_web_client_bind_address) %}
# Separate binding for the web client UI (operator-facing).
SFTPGO_HTTPD__BINDINGS__1__ADDRESS={{ sftpgo_web_client_bind_address }}
SFTPGO_HTTPD__BINDINGS__1__PORT={{ sftpgo_web_client_bind_port }}
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_ADMIN=false
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_CLIENT=true
{% endif %}

# ============================================================================
# Data provider
# ============================================================================
SFTPGO_DATA_PROVIDER__DRIVER={{ sftpgo_data_provider_driver }}
SFTPGO_DATA_PROVIDER__NAME={{ sftpgo_data_provider_name }}

# ============================================================================
# Defender (built-in brute-force protection)
# ============================================================================
SFTPGO_COMMON__DEFENDER__ENABLED={{ sftpgo_defender_enabled | ternary('true', 'false') }}
SFTPGO_COMMON__DEFENDER__BAN_TIME={{ sftpgo_defender_ban_time_minutes }}
SFTPGO_COMMON__DEFENDER__THRESHOLD={{ sftpgo_defender_threshold }}
SFTPGO_COMMON__DEFENDER__SCORE_INVALID={{ sftpgo_defender_score_invalid }}
SFTPGO_COMMON__DEFENDER__SCORE_VALID={{ sftpgo_defender_score_valid }}
SFTPGO_COMMON__DEFENDER__OBSERVATION_TIME={{ sftpgo_defender_observation_time_minutes }}

# ============================================================================
# TOTP (per-user opt-in via WebClient)
# ============================================================================
{% if sftpgo_totp_enabled %}
SFTPGO_MFA__TOTP__0__NAME=Default
SFTPGO_MFA__TOTP__0__ISSUER={{ sftpgo_totp_issuer }}
SFTPGO_MFA__TOTP__0__ALGO=sha1
{% endif %}

# ============================================================================
# Logging
# ============================================================================
SFTPGO_LOG_FILE_PATH={{ sftpgo_log_file_path }}
SFTPGO_LOG_LEVEL={{ sftpgo_log_level }}
SFTPGO_LOG_COMPRESS={{ sftpgo_log_compress | ternary('true', 'false') }}
